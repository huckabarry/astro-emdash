							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "it-hello-15s",
									"text": "Se mi hai trovato attraverso un vecchio profilo fediverse o un side-project, probabilmente ormai non sono piu molto attivo li. Questo sito e Bluesky restano i modi migliori per trovarmi.",
									"marks": []
