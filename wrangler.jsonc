{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "afterword-emdash-lab",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ATPROTO_REPO": "did:plc:vt4k6d3e5rjw65cuzaf3nufq",
		"MAILGUN_DOMAIN": "mg.afterword.blog",
		"MAILGUN_FROM_EMAIL": "postmaster@mg.afterword.blog",
		"STANDARD_SITE_PUBLICATION_URI": "at://did:plc:vt4k6d3e5rjw65cuzaf3nufq/site.standard.publication/3mk5ifnbo552g",
		"STANDARD_SITE_IDENTIFIER": "afterword.blog",
		"STANDARD_SITE_PDS_URL": "https://eurosky.social"
	},
	"assets": {
		"directory": "./dist",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "afterword-emdash-lab",
			"database_id": "90e7e3ca-cbeb-48e1-9832-074509d7941e"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "afterword-emdash-lab",
			"preview_bucket_name": "afterword-emdash-lab"
		},
		{
			"binding": "LEGACY_MEDIA",
			"bucket_name": "afterword",
			"preview_bucket_name": "afterword"
		},
	],
	"observability": {
		"enabled": true,
	}
}
