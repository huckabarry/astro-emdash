---
import { getEmDashCollection, getSection } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { getImageUrl, formatDisplayDate } from "../lib/afterword";
import { getLatestTrack } from "../lib/media";
import {
	PUBLIC_ARCHIVE_CACHE_CONTROL,
	getPostStringField,
	getResolvedPostTagSlugMap,
	PLANNING_TAG_SLUGS,
} from "../lib/emdash-content";

Astro.response.headers.set("Cache-Control", PUBLIC_ARCHIVE_CACHE_CONTROL);

const [fieldNotesResult, homeIntroSection, latestTrack] = await Promise.all([
	getEmDashCollection("posts", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: 80,
	}),
	getSection("home-intro"),
	getLatestTrack(),
]);

Astro.cache.set(fieldNotesResult.cacheHint);

const fieldNotesTagSlugMap = await getResolvedPostTagSlugMap(fieldNotesResult.entries);
const fieldNotesPosts = fieldNotesResult.entries
	.filter((post) => getPostStringField(post, "source_type") !== "earlier-web")
	.filter((post) => {
		const slugs = fieldNotesTagSlugMap.get(post.id) || [];
		return !slugs.includes("now") && !PLANNING_TAG_SLUGS.some((slug) => slugs.includes(slug));
	})
	.slice(0, 6);
---

<Base
	title="Afterword"
	description="Short updates, photos, and longer reflections on place, music, design, and daily life."
>
	<section class="stream-head">
		<div class="stream-head__lede">
			{homeIntroSection?.content?.length ? (
				<PortableText value={homeIntroSection.content} />
			) : (
				<p>
					Urban planner, photographer, gardener, and habitual maker of things. I use this
					space for short updates, photos, and longer reflections on place, music, design, and
					daily life. If you've found your way here and want to say hello, I'd love to hear from
					you.
				</p>
			)}
		</div>
	</section>

		<div class="section-stack">
			<!-- Homepage status carousel intentionally removed. Restore from git history if it belongs here again. -->

			<section class="section-block section-block-writing">
			<h2 class="section-title">Field Notes</h2>
			{fieldNotesPosts.length ? (
				<section class="blog-list">
					{fieldNotesPosts.map((post) => {
						const coverImage = getImageUrl(post.data.featured_image, Astro.url.origin);
						return (
							<article class="blog-row home-feature-row">
								<a
									class="blog-row__link home-feature-row__link"
									href={`/posts/${post.id}`}
									data-astro-prefetch="viewport"
								>
									{coverImage && (
										<div class="home-feature-row__media">
											<img
												class="home-feature-row__image"
												src={coverImage}
												alt={post.data.title}
												loading="lazy"
											/>
										</div>
									)}
									<div class="home-feature-row__body">
										<time class="blog-row__date" datetime={post.data.publishedAt?.toISOString()}>
											{formatDisplayDate(post.data.publishedAt ?? undefined)}
										</time>
										<h3>{post.data.title}</h3>
										<p>{post.data.excerpt}</p>
									</div>
								</a>
							</article>
						);
					})}
				</section>
			) : (
				<p class="empty-state">No field notes are available yet.</p>
			)}
			<div class="home-stream-tags">
				<a class="tag-pill" href="/tags/field-notes" data-astro-prefetch="viewport">Field Notes</a>
				<a class="home-updates__more-link" href="/field-notes" data-astro-prefetch="viewport">Read more field notes <span aria-hidden="true">→</span></a>
			</div>
		</section>

		<section class="section-block section-block-track">
			<div class="section-head">
				<h2 class="section-title">Latest Track</h2>
				<a class="home-updates__more-link" href="/music" data-astro-prefetch="viewport">
					More music <span aria-hidden="true">→</span>
				</a>
			</div>
			<div class="home-track">
				{latestTrack ? (
					<article class="home-track-card">
						{latestTrack.imageUrl ? (
							<a class="home-track-card__cover" href={latestTrack.href}>
								<img
									class="home-track-card__image"
									src={latestTrack.imageUrl}
									alt={latestTrack.imageAlt || latestTrack.title}
									loading="lazy"
									decoding="async"
								/>
							</a>
						) : null}
						<div class="home-track-card__body">
							<time class="home-track-card__meta" datetime={latestTrack.dateIso}>
								{latestTrack.dateLabel}
							</time>
							<h3 class="home-track-card__title">
								<a href={latestTrack.href}>{latestTrack.title}</a>
							</h3>
							{latestTrack.artist ? <p class="home-track-card__artist">{latestTrack.artist}</p> : null}
							{latestTrack.summary ? <p class="home-track-card__summary">{latestTrack.summary}</p> : null}
							<div class="home-track-card__actions">
								<a class="tag-pill mixed-feed__action" href={latestTrack.href}>Open entry</a>
								{latestTrack.links.map((link) => (
									<a
										class="tag-pill mixed-feed__action"
										href={link.url}
										target={link.external ? "_blank" : undefined}
										rel={link.external ? "noreferrer" : undefined}
									>
										{link.label}
									</a>
								))}
							</div>
							{latestTrack.embedUrl ? (
								<div class="home-track-card__embed">
									<iframe
										class="home-track-card__embed-frame"
										title={`Listen to ${latestTrack.title}`}
										src={latestTrack.embedUrl}
										loading="lazy"
										allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
										sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
									></iframe>
								</div>
							) : latestTrack.audioUrl ? (
								<div class="home-track-card__audio">
									<audio
										controls
										preload="none"
										src={latestTrack.audioUrl}
										aria-label={`Preview ${latestTrack.title}`}
									></audio>
								</div>
							) : null}
						</div>
					</article>
				) : (
					<p class="empty-state">No recent tracks are available yet.</p>
				)}
			</div>
		</section>
	</div>

		<script is:inline data-astro-rerun>
			function warmRoute(href) {
			fetch(href, {
				credentials: "omit",
				headers: { "X-Afterword-Prefetch": "home" },
			}).catch(() => {});
		}
			const homeState = window.__afterwordHome ??= {
				initialized: false,
				cleanup() {},
			};

			function initHomePage() {
				homeState.cleanup();

				const cleanupFns = [];

				const timer = window.setTimeout(() => {
					warmRoute("/gallery");
					warmRoute("/now");
					warmRoute("/media");
			}, 2000);

			cleanupFns.push(() => window.clearTimeout(timer));
			homeState.cleanup = () => {
				while (cleanupFns.length) {
					const cleanup = cleanupFns.pop();
					cleanup?.();
				}
			};
		}

		if (!homeState.initialized) {
			homeState.initialized = true;
			document.addEventListener("astro:before-swap", () => homeState.cleanup());
			document.addEventListener("astro:page-load", initHomePage);
			window.addEventListener("pagehide", () => homeState.cleanup());
		}

		initHomePage();

	</script>
	<style>
		.home-track-card {
			display: grid;
			gap: 1rem;
		}

		.home-track-card__cover {
			display: block;
			text-decoration: none;
		}

		.home-track-card__image {
			display: block;
			width: min(100%, 18rem);
			border-radius: 0.7rem;
		}

		.home-track-card__body {
			display: grid;
			gap: 0.8rem;
		}

		.home-track-card__meta {
			color: var(--muted);
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}

		.home-track-card__title {
			margin: 0;
			font-size: clamp(1.35rem, 2vw, 1.75rem);
			line-height: 1.15;
		}

		.home-track-card__title a {
			color: var(--text);
			text-decoration: none;
		}

		.home-track-card__artist,
		.home-track-card__summary {
			margin: 0;
		}

		.home-track-card__artist {
			color: var(--muted);
		}

		.home-track-card__summary {
			line-height: 1.65;
		}

		.home-track-card__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.55rem;
		}

		.home-track-card__embed {
			width: 100%;
		}

		.home-track-card__embed-frame {
			display: block;
			width: 100%;
			min-height: 190px;
			border: 0;
			border-radius: 0.7rem;
			background: color-mix(in srgb, var(--surface) 26%, transparent);
		}

		.home-track-card__audio audio {
			width: 100%;
		}
	</style>
</Base>
