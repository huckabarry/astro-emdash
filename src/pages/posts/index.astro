---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import { getImageUrl, formatDisplayDate } from "../../lib/afterword";
import { PUBLIC_ARCHIVE_CACHE_CONTROL, getPostStringField } from "../../lib/emdash-content";

Astro.response.headers.set("Cache-Control", PUBLIC_ARCHIVE_CACHE_CONTROL);

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 40,
	cursor,
});

Astro.cache.set(cacheHint);
const visiblePosts = posts.filter((post) => getPostStringField(post, "source_type") !== "earlier-web");
---

<Base title="Posts" description="A compact archive for field notes, gallery posts, and urbanism writing.">
	<section class="stream-head">
		<h1 class="stream-head__title">Latest writing</h1>
		<p class="stream-head__lede">A compact archive for field notes, gallery posts, and urbanism writing.</p>
	</section>

	<section class="blog-list blog-list--archive" aria-label="Blog posts">
		{visiblePosts.map((post) => {
			const coverImage = getImageUrl(post.data.featured_image, Astro.url.origin);
			return (
				<article class:list={["blog-row", "h-entry", coverImage && "blog-row--with-image"]}>
					<a class="blog-row__link u-url" href={`/posts/${post.id}`}>
						{coverImage && <img class="blog-row__image" src={coverImage} alt={post.data.title} loading="lazy" />}
						<div class="blog-row__body">
							<time class="blog-row__date dt-published" datetime={post.data.publishedAt?.toISOString()}>
								{formatDisplayDate(post.data.publishedAt ?? undefined)}
							</time>
							<h2 class="p-name">{post.data.title}</h2>
							<p class="p-summary">{post.data.excerpt}</p>
							<span class="blog-row__read-more">Read more <span aria-hidden="true">→</span></span>
						</div>
					</a>
				</article>
			);
		})}
	</section>

	{nextCursor && <p><a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>Older posts</a></p>}
</Base>
