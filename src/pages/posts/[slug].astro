---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getSeoMeta,
	getWidgetArea,
} from "emdash";
import { CommentForm, Comments, Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PostAuthorSection from "../../components/PostAuthorSection.astro";
import PostSidebar from "../../components/PostSidebar.astro";
import { formatDisplayDate, getImageUrl } from "../../lib/afterword";
import { PUBLIC_ARCHIVE_CACHE_CONTROL, getPostStringField } from "../../lib/emdash-content";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint, isPreview } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (!isPreview) {
	Astro.response.headers.set("Cache-Control", PUBLIC_ARCHIVE_CACHE_CONTROL);
}

Astro.cache.set(cacheHint);

const seo = getSeoMeta(post, {
	siteTitle: "Afterword",
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultOgImage: getImageUrl(post.data.featured_image) || undefined,
});

const tags = await getEntryTerms("posts", post.data.id, "tag");
const { entries: recentPosts } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 50,
});
const orderedPosts = recentPosts.filter((entry) => getPostStringField(entry, "source_type") !== "earlier-web");
const currentIndex = orderedPosts.findIndex((entry) => entry.id === post.id);
const previousPost = currentIndex >= 0 ? orderedPosts[currentIndex + 1] ?? null : null;
const nextPost = currentIndex > 0 ? orderedPosts[currentIndex - 1] ?? null : null;
const publishDate = formatDisplayDate(post.data.publishedAt ?? undefined);

const sidebarWidgetArea = await getWidgetArea("sidebar");
const hasSidebarWidgets = Boolean(sidebarWidgetArea?.widgets?.length);
---

<Base
	title={seo.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
	sidebar={hasSidebarWidgets}
>
	<article class="entry entry--blog h-entry">
		<div class="entry__meta">
			<a href="/posts">Blog</a>
			{publishDate && (
				<time class="dt-published" datetime={post.data.publishedAt?.toISOString()}>
					{publishDate}
				</time>
			)}
		</div>

		<h1 class="entry__title p-name" {...post.edit.title}>{post.data.title}</h1>
		<a class="p-author h-card" href="/">Bryan Robb</a>

		{tags.length > 0 && (
			<div class="entry__tags">
				{tags.map((tag) => (
					<a class="tag-pill entry__tag p-category" href={`/tags/${tag.slug}`}>
						{tag.label}
					</a>
				))}
			</div>
		)}

		{post.data.featured_image && (
			<figure class="entry__figure" {...post.edit.featured_image}>
				<Image image={post.data.featured_image} />
			</figure>
		)}

		<div class="entry__content e-content">
			<PortableText value={post.data.content} />
		</div>

		<PostAuthorSection />

		<section class="entry-comments" aria-labelledby="entry-comments-heading">
			<h2 id="entry-comments-heading" class="entry-comments__heading">
				Comments
			</h2>
			<CommentForm collection="posts" contentId={post.data.id} class="entry-comments__form" />
			<Comments collection="posts" contentId={post.data.id} class="entry-comments__list" />
		</section>

		<footer class="post-actions" aria-label="Post actions">
			<a class="post-action-link" href="/hello">Reply by email</a>
			<a class="post-action-link" href="/posts">Back to all posts</a>
		</footer>

		{(previousPost || nextPost) && (
			<nav class="post-navigation">
				<ul>
					<li class="post-navigation-item post-navigation-item-previous">
						{previousPost && (
							<a class="post-navigation-link" href={`/posts/${previousPost.id}`}>
								<span class="post-navigation-label">← Previous</span>
								<span class="post-navigation-title">{previousPost.data.title}</span>
							</a>
						)}
					</li>
					<li class="post-navigation-item post-navigation-item-next">
						{nextPost && (
							<a class="post-navigation-link" href={`/posts/${nextPost.id}`}>
								<span class="post-navigation-label">Next →</span>
								<span class="post-navigation-title">{nextPost.data.title}</span>
							</a>
						)}
					</li>
				</ul>
			</nav>
		)}
	</article>

	{hasSidebarWidgets ? (
		<Fragment slot="sidebar">
			<PostSidebar widgetArea={sidebarWidgetArea} />
		</Fragment>
	) : null}
</Base>

<style>
	.entry-comments {
		margin-top: 2.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.entry-comments__heading {
		margin: 0 0 1rem;
		font-size: 1.2rem;
		font-weight: 700;
	}

	.entry-comments__form {
		margin-bottom: 2rem;
	}

	.entry-comments :global(.ec-comment-form) {
		--ec-form-user-bg: var(--surface);
		--ec-form-user-border: var(--border);
		color: var(--text);
	}

	.entry-comments :global(.ec-comment-form-field input),
	.entry-comments :global(.ec-comment-form-field textarea) {
		background: #fff;
		border: 1px solid rgba(17, 24, 39, 0.16);
		color: #111827;
		caret-color: #111827;
	}

	.entry-comments :global(.ec-comment-form-field input::placeholder),
	.entry-comments :global(.ec-comment-form-field textarea::placeholder) {
		color: rgba(17, 24, 39, 0.55);
	}

	.entry-comments :global(.ec-comment-form-submit) {
		display: block;
		margin-left: auto;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
	}
</style>
