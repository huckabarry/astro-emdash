---
import Base from "../../layouts/Base.astro";

const siteUrl = "https://afterword.blog";
const feeds = [
	{
		title: "Tutto",
		description: "Il flusso pubblico completo di Afterword: scritti, aggiornamenti, media, check-in e archivio.",
		rssUrl: "/everything/feed.xml",
		jsonUrl: "/everything/feed.json",
	},
	{
		title: "Scritti",
		description: "Field notes, planning posts e altri testi piu lunghi da Afterword.",
		rssUrl: "/feed.xml",
		jsonUrl: "/feed.json",
	},
	{
		title: "Planning",
		description: "Solo i post su pianificazione e urbanistica.",
		rssUrl: "/planning/feed.xml",
		jsonUrl: "/planning/feed.json",
	},
	{
		title: "Stato",
		description: "Aggiornamenti brevi pubblicati da Bluesky sul sito.",
		rssUrl: "/status/feed.xml",
		jsonUrl: "/status/feed.json",
	},
	{
		title: "Media",
		description: "Album, brani, libri, film e serie dalla timeline media.",
		rssUrl: "/media/feed.xml",
		jsonUrl: "/media/feed.json",
	},
];

const microblogFeeds = [
	{
		title: "Writing JSON Feed",
		description: "Post lunghi con titolo, riassunto, HTML completo e immagini inline.",
		url: `${siteUrl}/feed.json`,
	},
	{
		title: "Status JSON Feed",
		description: "Micro post senza titoli finti, con foto e media dentro il contenuto.",
		url: `${siteUrl}/status/feed.json`,
	},
	{
		title: "Media JSON Feed",
		description: "Ascolti e media con artwork incluso direttamente nel contenuto del post.",
		url: `${siteUrl}/media/feed.json`,
	},
	{
		title: "Everything JSON Feed",
		description: "Il flusso pubblico completo, con post lunghi e micro post insieme.",
		url: `${siteUrl}/everything/feed.json`,
	},
];
---

<Base
	title="Iscriviti"
	description="Segui Afterword via RSS o feed JSON, con opzioni per scritti, planning, status, media e il flusso pubblico completo."
>
	<section class="section-block">
		<h1 class="section-title">Iscriviti</h1>
		<article class="content content-page">
			<div class="post-full-content">
				<section class="content-body subscribe-page">
					<p class="locale-note">
						Il modo piu semplice per seguire Afterword adesso e dal tuo reader. RSS di solito
						e la scelta piu semplice, ma ho incluso anche i feed JSON.
					</p>

					<section class="subscribe-microblog">
						<h2>Import in Micro.blog</h2>
						<p>
							Se vuoi importare Afterword in Micro.blog, questi URL JSON Feed sono il
							punto di partenza migliore. Writing e Status sono la coppia piu pulita.
						</p>
						<div class="subscribe-copy-list">
							{microblogFeeds.map((feed) => (
								<section class="subscribe-copy-card">
									<h3>{feed.title}</h3>
									<p>{feed.description}</p>
									<input class="subscribe-copy-input" type="text" readonly value={feed.url} />
								</section>
							))}
						</div>
					</section>

					<div class="subscribe-feed-list">
						{feeds.map((feed) => (
							<section class="subscribe-feed-card">
								<h2>{feed.title}</h2>
								<p>{feed.description}</p>
								<div class="subscribe-feed-links">
									<a href={feed.rssUrl}>RSS</a>
									<a href={feed.jsonUrl}>JSON</a>
								</div>
							</section>
						))}
					</div>
				</section>
			</div>
		</article>
	</section>
</Base>

<style>
	.subscribe-page {
		display: grid;
		gap: 2rem;
	}

	.subscribe-feed-list {
		display: grid;
		gap: 1rem;
	}

	.subscribe-microblog {
		display: grid;
		gap: 1rem;
	}

	.subscribe-microblog h2 {
		margin: 0;
	}

	.subscribe-copy-list {
		display: grid;
		gap: 1rem;
	}

	.subscribe-copy-card {
		padding: 1.1rem 1.2rem;
		border: 1px solid rgba(245, 241, 171, 0.18);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.subscribe-copy-card h3 {
		margin: 0 0 0.45rem;
		font-size: 1rem;
	}

	.subscribe-copy-card p {
		margin: 0 0 0.85rem;
	}

	.subscribe-copy-input {
		width: 100%;
		padding: 0.7rem 0.8rem;
		border: 1px solid rgba(245, 241, 171, 0.18);
		border-radius: 0.45rem;
		background: rgba(0, 0, 0, 0.2);
		color: inherit;
		font: inherit;
		font-family: var(--font-mono, "IBM Plex Mono", monospace);
	}

	.subscribe-feed-card {
		padding: 1.1rem 1.2rem;
		border: 1px solid rgba(245, 241, 171, 0.18);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.subscribe-feed-card h2 {
		margin: 0 0 0.45rem;
		font-size: 1.05rem;
	}

	.subscribe-feed-card p {
		margin: 0;
	}

	.subscribe-feed-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 0.85rem;
		font-family: var(--font-mono, "IBM Plex Mono", monospace);
		font-size: 0.92rem;
	}

	.subscribe-feed-links a {
		font-weight: 600;
	}

	.locale-note {
		margin: 0;
		color: rgba(245, 243, 238, 0.78);
	}
</style>
