---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { getCheckinsPage, type CheckinItem } from "../../lib/checkins";
import { getMediaTimelinePage, type MediaTimelineItem } from "../../lib/media";
import { getStatusFeedPage } from "../../lib/status-feed";

export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=60, s-maxage=240, stale-while-revalidate=600",
);

const [statusPage, checkinsPage, mediaPage] = await Promise.all([
	getStatusFeedPage({ limit: 18, includeReplies: false }),
	getCheckinsPage(env as unknown as Record<string, unknown>, { limit: 18 }),
	getMediaTimelinePage(0, 18),
]);

type StatusItem = (typeof statusPage.statuses)[number];

type MixedFeedEntry =
	| { kind: "status"; date: Date; status: StatusItem }
	| { kind: "checkin"; date: Date; checkin: CheckinItem }
	| { kind: "media"; date: Date; media: MediaTimelineItem };

const mixedFeed: MixedFeedEntry[] = [
	...statusPage.statuses.map((status) => ({
		kind: "status" as const,
		date: status.date,
		status,
	})),
	...checkinsPage.items.map((checkin) => ({
		kind: "checkin" as const,
		date: checkin.visitedAt,
		checkin,
	})),
	...mediaPage.items.map((media) => ({
		kind: "media" as const,
		date: new Date(media.dateIso),
		media,
	})),
]
	.sort((left, right) => right.date.getTime() - left.date.getTime())
	.slice(0, 42);

function formatDate(value: Date) {
	return new Intl.DateTimeFormat("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	}).format(value);
}

function socialRepostCount(post: StatusItem) {
	return (post.repostCount || 0) + (post.quoteCount || 0);
}

function getLocalStatusPath(slug: string) {
	return `/status/${slug}`;
}

function getVideoLabel(post: StatusItem) {
	return post.video?.alt?.trim() || "Watch video on Bluesky";
}

function summarizeCheckin(item: CheckinItem, maxLength = 220) {
	const source = String(item.excerpt || item.note || "").trim().replace(/\s+/g, " ");
	if (!source || source.length <= maxLength) return source;
	return `${source.slice(0, maxLength).trimEnd()}…`;
}
---

<Base
	title="Status"
	description="A mixed live stream from Afterword: Bluesky posts, check-ins, and media entries in one place."
>
	<section class="stream-head">
		<h1 class="stream-head__title">Status</h1>
		<p class="stream-head__lede">
			Bluesky posts, check-ins, and media notes folded into one running stream.
		</p>
	</section>

	{mixedFeed.length ? (
		<section class="mixed-feed" aria-label="Combined live feed">
			{mixedFeed.map((entry) => (
				<article class="mixed-feed__entry">
					<div class="mixed-feed__meta-column">
						<time class="mixed-feed__date" datetime={entry.date.toISOString()}>
							{formatDate(entry.date)}
						</time>
					</div>

					<div class="mixed-feed__rail" aria-hidden="true">
						<span class="mixed-feed__dot"></span>
					</div>

					<div class="mixed-feed__content">
						{entry.kind === "status" ? (
							<div class="mixed-feed__item mixed-feed__item--status">
								<p class="mixed-feed__kicker">Bluesky</p>
								<div class="status-row h-entry">
									<div class="status-row__body">
										{entry.status.replyTo ? (
											<p class="status-row__reply-context">
												In reply to
												<a href={entry.status.replyTo.blueskyUrl} target="_blank" rel="noreferrer">
													{entry.status.replyTo.displayName || entry.status.replyTo.handle}
												</a>
											</p>
										) : null}
										<div class="status-row__meta">
											<div class="status-row__byline">
												<span class="status-row__name p-author h-card">
													<span class="p-name">{entry.status.displayName}</span>
													<span class="u-url" hidden>{entry.status.blueskyUrl}</span>
												</span>
												<span class="status-row__handle p-nickname">{entry.status.handle}</span>
											</div>
										</div>
										<a class="u-url" href={getLocalStatusPath(entry.status.slug)} hidden>
											{getLocalStatusPath(entry.status.slug)}
										</a>
										{entry.status.html ? (
											<a class="status-row__permalink u-url" href={getLocalStatusPath(entry.status.slug)}>
												<div class="status-row__content e-content" set:html={entry.status.html}></div>
											</a>
										) : null}
										{entry.status.quotedPost ? (
											<a class="status-quote" href={entry.status.quotedPost.blueskyUrl} target="_blank" rel="noreferrer">
												<div class="status-quote__meta">
													{entry.status.quotedPost.avatar ? (
														<img
															class="status-quote__avatar"
															src={entry.status.quotedPost.avatar}
															alt={entry.status.quotedPost.displayName}
															loading="lazy"
														/>
													) : null}
													<div class="status-quote__byline">
														<strong>{entry.status.quotedPost.displayName}</strong>
														<span>{entry.status.quotedPost.handle}</span>
													</div>
												</div>
												{entry.status.quotedPost.html ? (
													<div class="status-quote__content" set:html={entry.status.quotedPost.html}></div>
												) : null}
												{entry.status.quotedPost.images.length ? (
													<div
														class:list={[
															"status-row__media",
															"status-row__media--quoted",
															entry.status.quotedPost.images.length > 1 && "status-row__media--multi",
														]}
													>
														{entry.status.quotedPost.images.map((image) => (
															<img src={image.thumb} alt={image.alt || "Quoted post image"} loading="lazy" />
														))}
													</div>
												) : null}
												{entry.status.quotedPost.external ? (
													<span class="status-card status-card--quoted">
														{entry.status.quotedPost.external.thumb ? (
															<img
																class="status-card__thumb"
																src={entry.status.quotedPost.external.thumb}
																alt={entry.status.quotedPost.external.title || entry.status.quotedPost.external.domain}
																loading="lazy"
															/>
														) : null}
														<span class="status-card__domain">{entry.status.quotedPost.external.domain}</span>
														<strong class="status-card__title">{entry.status.quotedPost.external.title}</strong>
														{entry.status.quotedPost.external.description ? (
															<span class="status-card__description">
																{entry.status.quotedPost.external.description}
															</span>
														) : null}
													</span>
												) : null}
											</a>
										) : null}
										{entry.status.images.length ? (
											<div
												class:list={[
													"status-row__media",
													entry.status.images.length > 1 && "status-row__media--multi",
												]}
											>
												{entry.status.images.map((image) => (
													<a class="status-row__image" href={getLocalStatusPath(entry.status.slug)}>
														<img src={image.thumb} alt={image.alt || "Bluesky image"} loading="lazy" />
													</a>
												))}
											</div>
										) : null}
										{entry.status.external ? (
											<a class="status-card" href={entry.status.external.uri} target="_blank" rel="noreferrer">
												{entry.status.external.thumb ? (
													<img
														class="status-card__thumb"
														src={entry.status.external.thumb}
														alt={entry.status.external.title || entry.status.external.domain}
														loading="lazy"
													/>
												) : null}
												<span class="status-card__domain">{entry.status.external.domain}</span>
												<strong class="status-card__title">{entry.status.external.title}</strong>
												{entry.status.external.description ? (
													<span class="status-card__description">{entry.status.external.description}</span>
												) : null}
											</a>
										) : null}
										{entry.status.video ? (
											<a class="status-row__video" href={entry.status.blueskyUrl} target="_blank" rel="noreferrer">
												{entry.status.video.thumbnail ? (
													<span class="status-row__video-thumb-wrap">
														<img
															class="status-row__video-thumb"
															src={entry.status.video.thumbnail}
															alt={getVideoLabel(entry.status)}
															loading="lazy"
														/>
														<span class="status-row__video-badge" aria-hidden="true">Video</span>
													</span>
												) : null}
												<span class="status-row__video-link">{getVideoLabel(entry.status)}</span>
											</a>
										) : null}
										<div class="status-row__actions">
											<div class="status-row__metrics">
												<a class="status-row__action" href={getLocalStatusPath(entry.status.slug)}>
													<span>{entry.status.replyCount}</span>
												</a>
												<a class="status-row__action" href={getLocalStatusPath(entry.status.slug)}>
													<span>{socialRepostCount(entry.status)}</span>
												</a>
												<a class="status-row__action" href={getLocalStatusPath(entry.status.slug)}>
													<span>{entry.status.likeCount}</span>
												</a>
											</div>
											<div class="status-row__reply-pills">
												<a class="status-row__reply-pill" href={entry.status.blueskyUrl} target="_blank" rel="noreferrer">
													<span>Reply on Bluesky</span>
												</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						) : entry.kind === "checkin" ? (
							<div class="mixed-feed__item mixed-feed__item--checkin">
								<p class="mixed-feed__kicker">Check-in</p>
								<article class="mixed-checkin">
									{entry.checkin.mapPreviewPath ? (
										<a class="mixed-checkin__map" href={entry.checkin.canonicalPath}>
											<img
												class="mixed-checkin__map-image"
												src={entry.checkin.mapPreviewPath}
												alt={`Map preview for ${entry.checkin.name}`}
												loading="lazy"
												decoding="async"
												width="640"
												height="400"
											/>
										</a>
									) : null}
									<div class="mixed-checkin__body">
										<h2 class="mixed-feed__title">
											<a href={entry.checkin.canonicalPath}>{entry.checkin.name}</a>
										</h2>
										{entry.checkin.place ? <p class="mixed-checkin__place">{entry.checkin.place}</p> : null}
										{entry.checkin.venueCategory ? (
											<p class="mixed-checkin__kicker">{entry.checkin.venueCategory}</p>
										) : null}
										{summarizeCheckin(entry.checkin) ? (
											<p class="mixed-feed__summary">{summarizeCheckin(entry.checkin)}</p>
										) : null}
										<div class="mixed-feed__actions">
											<a class="tag-pill mixed-feed__action" href={entry.checkin.canonicalPath}>Open check-in</a>
											{entry.checkin.appleMapsUrl ? (
												<a class="tag-pill mixed-feed__action" href={entry.checkin.appleMapsUrl} target="_blank" rel="noreferrer">
													Map
												</a>
											) : null}
											{entry.checkin.website ? (
												<a class="tag-pill mixed-feed__action" href={entry.checkin.website} target="_blank" rel="noreferrer">
													Website
												</a>
											) : null}
										</div>
									</div>
								</article>
							</div>
						) : (
							<div class="mixed-feed__item mixed-feed__item--media">
								<p class="mixed-feed__kicker">{entry.media.label}</p>
								<div class:list={["media-entry", !entry.media.imageUrl && "media-entry--text-only"]}>
									{entry.media.imageUrl ? (
										<a class="media-entry__cover" href={entry.media.href}>
											<img
												src={entry.media.imageUrl}
												alt={entry.media.imageAlt || entry.media.title}
												loading="lazy"
											/>
										</a>
									) : null}
									<div class="media-entry__body">
										<h2 class="mixed-feed__title">
											<a href={entry.media.href}>{entry.media.title}</a>
										</h2>
										{entry.media.artist ? (
											<p class="media-entry__credit">{entry.media.artist}</p>
										) : entry.media.credit ? (
											<p class="media-entry__credit">{entry.media.credit}</p>
										) : null}
										{entry.media.activityLabel ? (
											<p class="mixed-feed__subtle">Latest update: {entry.media.activityLabel}</p>
										) : null}
										{entry.media.summary ? <p class="mixed-feed__summary">{entry.media.summary}</p> : null}
										{entry.media.audioUrl ? (
											<div class="mixed-feed__audio">
												<audio controls preload="none" src={entry.media.audioUrl} aria-label={`Preview ${entry.media.title}`}></audio>
											</div>
										) : null}
										{entry.media.tags.length ? (
											<div class="mixed-feed__tags">
												{entry.media.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
											</div>
										) : null}
										{entry.media.links.length ? (
											<div class="mixed-feed__actions">
												<a class="tag-pill mixed-feed__action" href={entry.media.href}>Open entry</a>
												{entry.media.links.map((link) => (
													<a
														class="tag-pill mixed-feed__action"
														href={link.url}
														target={link.external ? "_blank" : undefined}
														rel={link.external ? "noreferrer" : undefined}
													>
														{link.label}
													</a>
												))}
											</div>
										) : null}
									</div>
								</div>
							</div>
						)}
					</div>
				</article>
			))}
		</section>
	) : (
		<p class="mixed-feed__empty">Nothing has landed here yet.</p>
	)}
</Base>

<style>
	.stream-head {
		margin-bottom: 1.25rem;
	}

	.stream-head__title {
		margin: 0;
	}

	.stream-head__lede {
		margin: 0.55rem 0 0;
		max-width: 42rem;
		color: var(--muted);
	}

	.mixed-feed {
		display: grid;
		gap: 0;
	}

	.mixed-feed__entry {
		display: grid;
		grid-template-columns: minmax(4.6rem, 5.4rem) 1.1rem minmax(0, 1fr);
		gap: 0 1rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--border);
	}

	.mixed-feed__entry:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.mixed-feed__meta-column {
		padding-top: 0.15rem;
	}

	.mixed-feed__date {
		display: inline-block;
		color: var(--accent);
		font-size: 0.78rem;
		line-height: 1.35;
		text-decoration: none;
	}

	.mixed-feed__rail {
		position: relative;
	}

	.mixed-feed__rail::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: -1.1rem;
		left: 50%;
		width: 1px;
		background: color-mix(in srgb, var(--border) 80%, transparent);
		transform: translateX(-50%);
	}

	.mixed-feed__entry:last-child .mixed-feed__rail::before {
		bottom: 0;
	}

	.mixed-feed__dot {
		position: absolute;
		top: 0.3rem;
		left: 50%;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--accent);
		transform: translateX(-50%);
	}

	.mixed-feed__content {
		min-width: 0;
	}

	.mixed-feed__item {
		min-width: 0;
	}

	.mixed-feed__item--status .status-row {
		grid-template-columns: minmax(0, 1fr);
		gap: 0;
	}

	.mixed-feed__kicker,
	.mixed-checkin__kicker,
	.mixed-feed__subtle {
		margin: 0 0 0.5rem;
		color: var(--muted);
		font-size: 0.8rem;
		line-height: 1.35;
	}

	.mixed-feed__kicker,
	.mixed-checkin__kicker {
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.mixed-feed__item--checkin > .mixed-feed__kicker,
	.mixed-feed__item--media > .mixed-feed__kicker {
		margin-bottom: 0.75rem;
	}

	.mixed-feed__title {
		margin: 0;
		font-size: clamp(1.15rem, 1.35vw, 1.45rem);
		line-height: 1.12;
		color: #fff;
	}

	.mixed-feed__title a {
		color: inherit;
		text-decoration: none;
	}

	.mixed-feed__summary {
		margin: 0.55rem 0 0;
		color: var(--muted);
		line-height: 1.6;
	}

	.mixed-feed__actions,
	.mixed-feed__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.8rem;
	}

	.mixed-feed__audio {
		margin-top: 0.8rem;
	}

	.mixed-feed__audio audio {
		width: 100%;
		max-width: 20rem;
	}

	.mixed-checkin {
		display: grid;
		grid-template-columns: minmax(10rem, 11rem) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
	}

	.mixed-checkin__map {
		display: block;
		overflow: hidden;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--surface) 82%, white 18%);
		aspect-ratio: 1 / 1;
	}

	.mixed-checkin__map-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.mixed-checkin__body {
		min-width: 0;
	}

	.mixed-checkin__place {
		margin: 0.45rem 0 0;
		color: #d7d8d4;
	}

	.mixed-feed__empty {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.mixed-feed__entry {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}

		.mixed-feed__meta-column {
			padding-top: 0;
		}

		.mixed-feed__rail {
			display: none;
		}

		.mixed-checkin {
			grid-template-columns: 1fr;
		}

		.mixed-checkin__map {
			display: none;
		}
	}
</style>
