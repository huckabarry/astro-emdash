		display: block;
	}

	.status-row__video-thumb {
		display: block;
		width: 100%;
		max-height: 38rem;
		border-radius: 12px;
		background: #0f1216;
		object-fit: cover;
	}

	.status-row__video-badge {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: rgba(15, 18, 22, 0.82);
		color: #fff;
		font-size: 0.78rem;
		font-weight: 600;
	}

	.status-row__video-link {
		font-size: 0.92rem;
		color: var(--muted);
	}

	.status-row__video-link:hover {
		color: var(--text);
	}

	.status-list__footer {
		display: grid;
		gap: 0.75rem;
		padding-top: 1.5rem;
	}

	.status-list__status,
	.status-list__error {
		margin: 0;
		color: var(--muted);
	}

	.status-list__load-more {
		display: flex;
	}

	.status-list__load-button:disabled {
