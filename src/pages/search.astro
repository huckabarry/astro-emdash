---
export const prerender = false;

import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { extractText } from "../utils/reading-time";
import { PUBLIC_SEARCH_CACHE_CONTROL } from "../lib/emdash-content";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const normalizedQuery = query.toLowerCase();

Astro.response.headers.set("Cache-Control", PUBLIC_SEARCH_CACHE_CONTROL);

const postsResult = query
	? await getEmDashCollection("posts", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: 200,
	})
	: null;

if (postsResult) {
	Astro.cache.set(postsResult.cacheHint);
}

const allPosts = postsResult?.entries ?? [];

function matchesQuery(post: (typeof allPosts)[number], q: string): boolean {
	if (!q) return false;
	const title = (post.data.title || "").toLowerCase();
	const excerpt = (post.data.excerpt || "").toLowerCase();
	const content = extractText(post.data.content).toLowerCase();
	return title.includes(q) || excerpt.includes(q) || content.includes(q);
}

const results = query ? allPosts.filter((post) => matchesQuery(post, normalizedQuery)) : [];
---

<Base title={query ? `Search: ${query}` : "Search"} description="Search posts">
	<div class="search-page">
		<header class="page-header">
			<h1 class="section-title">Search</h1>
			<p>Look through posts, notes, and imported archive entries.</p>
		</header>

		<form method="get" action="/search" class="search-form">
			<input
				type="search"
				name="q"
				value={query}
				placeholder="Search posts"
				class="search-input"
				autofocus
			/>
			<button type="submit" class="search-button">Search</button>
		</form>

		{query && (
			<p class="article-meta">
				{results.length === 0
					? `No results for "${query}"`
					: `${results.length} result${results.length === 1 ? "" : "s"} for "${query}"`}
			</p>
		)}

		{results.length > 0 && (
			<ul class="post-list" role="list">
				{results.map((post, index) => {
					const currentYear = post.data.publishedAt?.getFullYear();
					const previousYear = results[index - 1]?.data.publishedAt?.getFullYear();
					return (
						<li>
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								href={`/posts/${post.id}`}
								date={post.data.publishedAt ?? undefined}
								showYear={currentYear !== previousYear}
							/>
						</li>
					);
				})}
			</ul>
		)}

		{!query && <p class="article-meta">Enter a search term to find posts.</p>}
	</div>
</Base>
