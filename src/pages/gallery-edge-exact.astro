---
import { getEmDashCollection, getMenu, getSiteSetting } from "emdash";
import { getImageUrl } from "../lib/afterword";
import {
	PUBLIC_ARCHIVE_CACHE_CONTROL,
	dedupeEntriesById,
	fallbackTagLabel,
	getPostTagSlugs,
	sortEntriesByPublishedAtDesc,
} from "../lib/emdash-content";

Astro.response.headers.set("Cache-Control", PUBLIC_ARCHIVE_CACHE_CONTROL);

const configuredSiteTitle = await getSiteSetting("title");
const siteTitle =
	typeof configuredSiteTitle === "string" && configuredSiteTitle.trim()
		? configuredSiteTitle.trim()
		: "Afterword";

const [primaryMenu, secondaryMenu, galleryResult, photographyResult, fieldNotesResult] =
	await Promise.all([
		getMenu("primary"),
		getMenu("more"),
		getEmDashCollection("posts", {
			status: "published",
			where: { tag: "gallery" },
			orderBy: { published_at: "desc" },
			limit: 200,
		}),
		getEmDashCollection("posts", {
			status: "published",
			where: { tag: "photography" },
			orderBy: { published_at: "desc" },
			limit: 200,
		}),
		getEmDashCollection("posts", {
			status: "published",
			where: { tag: "field-notes" },
			orderBy: { published_at: "desc" },
			limit: 200,
		}),
	]);

Astro.cache.set(galleryResult.cacheHint);
Astro.cache.set(photographyResult.cacheHint);
Astro.cache.set(fieldNotesResult.cacheHint);

type GalleryPost = {
	id: string;
	slug?: string | null;
	data: {
		title?: string | null;
		publishedAt?: Date | string | null;
		featured_image?: unknown;
		tags?: string[] | null;
	};
};

function sanitizeSegment(value: string) {
	return String(value || "")
		.toLowerCase()
		.trim()
		.replace(/[^a-z0-9._-]+/g, "-")
		.replace(/^-+|-+$/g, "") || "item";
}

function getImageSourceUrl(image: unknown): string | null {
	return getImageUrl(image, Astro.url.origin);
}

function getImageFilename(image: unknown, fallbackSlug: string) {
	if (!image || typeof image !== "object") return `${sanitizeSegment(fallbackSlug)}.jpg`;
	const value = image as Record<string, unknown>;
	const filename =
		typeof value.filename === "string" && value.filename.trim() ? value.filename.trim() : null;
	if (filename) return filename;

	try {
		const sourceUrl = getImageSourceUrl(image);
		if (sourceUrl) {
			const pathname = new URL(sourceUrl).pathname.split("/").filter(Boolean).pop();
			if (pathname) return pathname;
		}
	} catch {
		// Fall through to slug-based filename.
	}

	return `${sanitizeSegment(fallbackSlug)}.jpg`;
}

function getGalleryAssetKey(post: GalleryPost, image: unknown) {
	const slug = sanitizeSegment(post.slug || post.id);
	const filename = sanitizeSegment(getImageFilename(image, slug));
	return `${slug}/01-${filename}`;
}

function getGalleryVariantUrl(
	post: GalleryPost,
	image: unknown,
	preset: "thumb-sm" | "thumb-md" | "thumb" | "large",
	sourceUrl: string,
) {
	if (sourceUrl.includes("/_emdash/api/media/file/")) return sourceUrl;

	const assetKey = getGalleryAssetKey(post, image);
	const url = new URL(`/gallery-images/${preset}/${assetKey}`, Astro.url.origin);
	url.searchParams.set("src", sourceUrl);
	return url.toString();
}

const fallbackPrimaryNavLinks = [
	{ href: "/", label: "Home" },
	{ href: "/status", label: "Status" },
	{ href: "/gallery", label: "Gallery" },
	{ href: "/pages/about", label: "About" },
];

const fallbackSecondaryNavLinks = [
	{ href: "/hello", label: "Hello" },
	{ href: "/check-ins", label: "Check-ins" },
	{ href: "/media", label: "Media" },
	{ href: "/colophon", label: "Colophon" },
	{ href: "/subscribe", label: "Subscribe" },
];

const primaryNavLinks = primaryMenu?.items?.length
	? primaryMenu.items.map((item) => ({ href: item.url, label: item.label }))
	: fallbackPrimaryNavLinks;
const secondaryNavLinks = secondaryMenu?.items?.length
	? secondaryMenu.items.map((item) => ({ href: item.url, label: item.label }))
	: fallbackSecondaryNavLinks;

const posts = sortEntriesByPublishedAtDesc(
	dedupeEntriesById([
		...galleryResult.entries,
		...photographyResult.entries,
		...fieldNotesResult.entries,
	]) as GalleryPost[],
).filter((post) => post.data.featured_image);

const cards = posts
	.map((post) => {
		const featuredImage = post.data.featured_image;
		const sourceUrl = getImageSourceUrl(featuredImage);
		if (!sourceUrl) return null;

		const tags = getPostTagSlugs(post);
		const primaryTagSlug = tags.find(
			(tag) => !["gallery", "photography", "field-notes"].includes(tag),
		);
		const publishedAt = post.data.publishedAt ? new Date(post.data.publishedAt) : null;

		return {
			id: post.id,
			title: post.data.title || "Untitled",
			url: `/posts/${post.slug || post.id}`,
			tagLabel: primaryTagSlug ? fallbackTagLabel(primaryTagSlug) : null,
			tagUrl: primaryTagSlug ? `/tags/${primaryTagSlug}` : null,
			dateIso: publishedAt ? publishedAt.toISOString().slice(0, 10) : null,
			dateLabel: publishedAt
				? publishedAt.toLocaleDateString("en-GB", {
						day: "2-digit",
						month: "short",
						year: "numeric",
					})
				: null,
			src: getGalleryVariantUrl(post, featuredImage, "thumb-sm", sourceUrl),
			srcset: [
				`${getGalleryVariantUrl(post, featuredImage, "thumb-sm", sourceUrl)} 300w`,
				`${getGalleryVariantUrl(post, featuredImage, "thumb-md", sourceUrl)} 750w`,
				`${getGalleryVariantUrl(post, featuredImage, "thumb", sourceUrl)} 1140w`,
				`${getGalleryVariantUrl(post, featuredImage, "large", sourceUrl)} 1920w`,
			].join(", "),
			lightboxUrl: getGalleryVariantUrl(post, featuredImage, "large", sourceUrl),
		};
	})
	.filter(Boolean);

const bodyClass = "home-template is-head-middle-logo";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Edge Gallery Demo | {siteTitle}</title>
		<meta
			name="description"
			content="A hidden Astro experiment replicating Ghost Edge's gallery feed as closely as possible."
		/>
		<link rel="stylesheet" href="/edge-theme/assets/built/screen.css" />
	</head>
	<body class={bodyClass}>
		<div class="site">
			<header id="gh-head" class="gh-head gh-outer">
				<div class="gh-head-inner">
					<div class="gh-head-brand">
						<div class="gh-head-brand-wrapper">
							<a class="gh-head-logo" href="/">{siteTitle}</a>
						</div>
						<button class="gh-search gh-icon-btn" aria-label="Search this site" type="button">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
								width="20"
								height="20"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								></path>
							</svg>
						</button>
						<button class="gh-burger" aria-label="Toggle menu" type="button"></button>
					</div>

					<nav class="gh-head-menu">
						<ul class="nav">
							{primaryNavLinks.map((link) => (
								<li><a href={link.href}>{link.label}</a></li>
							))}
						</ul>
					</nav>

					<div class="gh-head-actions">
						<button class="gh-search gh-icon-btn" aria-label="Search this site" type="button">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								stroke-width="2"
								width="20"
								height="20"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
								></path>
							</svg>
						</button>
					</div>
				</div>
			</header>

			<div class="site-content">
				<main class="site-main">
					<div class="post-feed gh-feed">
						<div class="grid-item grid-sizer"></div>
						{cards.map((card) => (
							<div class="grid-item">
								<figure class="post">
									<a class="post-link" aria-label={`Navigate to ${card.title} page`} href={card.url}>
										<img
											class="post-image"
											srcset={card.srcset}
											sizes="(min-width: 1020px) 300px, (min-width: 641px) calc((100vw - 50px) / 3), calc((100vw - 40px) / 2)"
											src={card.src}
											alt={card.title}
											loading="lazy"
										/>
									</a>

									<a class="post-lightbox" aria-label="Expand image" href={card.lightboxUrl}>
										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="14"
											height="14"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<polyline points="15 3 21 3 21 9"></polyline>
											<polyline points="9 21 3 21 3 15"></polyline>
											<line x1="21" y1="3" x2="14" y2="10"></line>
											<line x1="3" y1="21" x2="10" y2="14"></line>
										</svg>
									</a>

									<figcaption class="post-caption">
										<h2 class="post-caption-title">{card.title}</h2>
										<div class="post-caption-meta">
											{card.tagLabel && card.tagUrl ? (
												<span class="post-caption-meta-item post-caption-meta-tag">
													<a href={card.tagUrl}>{card.tagLabel}</a>
												</span>
											) : null}
											{card.dateIso && card.dateLabel ? (
												<span class="post-caption-meta-item post-caption-meta-date">
													<time datetime={card.dateIso}>{card.dateLabel}</time>
												</span>
											) : null}
											<span class="post-caption-meta-item post-caption-meta-link">
												<a href={card.url}>View project</a>
											</span>
										</div>
									</figcaption>
								</figure>
							</div>
						))}
					</div>
				</main>
			</div>

			<footer class="gh-foot gh-outer">
				<div class="gh-foot-inner gh-inner">
					<div class="gh-copyright">{siteTitle} © {new Date().getFullYear()}</div>
					<nav class="gh-foot-menu">
						<ul class="nav">
							{secondaryNavLinks.map((link) => (
								<li><a href={link.href}>{link.label}</a></li>
							))}
						</ul>
					</nav>
					<div class="gh-powered-by">
						Powered by <a href="https://ghost.org/" target="_blank" rel="noopener">Ghost</a>
					</div>
				</div>
			</footer>
		</div>

		<div class="pswp" tabindex="-1" role="dialog" aria-hidden="true">
			<div class="pswp__bg"></div>

			<div class="pswp__scroll-wrap">
				<div class="pswp__container">
					<div class="pswp__item"></div>
					<div class="pswp__item"></div>
					<div class="pswp__item"></div>
				</div>

				<div class="pswp__ui pswp__ui--hidden">
					<div class="pswp__top-bar">
						<div class="pswp__counter"></div>

						<button class="pswp__button pswp__button--close" title="Close (Esc)"></button>
						<button class="pswp__button pswp__button--share" title="Share"></button>
						<button class="pswp__button pswp__button--fs" title="Toggle fullscreen"></button>
						<button class="pswp__button pswp__button--zoom" title="Zoom in/out"></button>

						<div class="pswp__preloader">
							<div class="pswp__preloader__icn">
								<div class="pswp__preloader__cut">
									<div class="pswp__preloader__donut"></div>
								</div>
							</div>
						</div>
					</div>

					<div class="pswp__share-modal pswp__share-modal--hidden pswp__single-tap">
						<div class="pswp__share-tooltip"></div>
					</div>

					<button class="pswp__button pswp__button--arrow--left" title="Previous (arrow left)"></button>
					<button class="pswp__button pswp__button--arrow--right" title="Next (arrow right)"></button>

					<div class="pswp__caption">
						<div class="pswp__caption__center"></div>
					</div>
				</div>
			</div>
		</div>

		<script
			is:inline
			src="https://code.jquery.com/jquery-3.5.1.min.js"
			integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
			crossorigin="anonymous"
		></script>
		<script is:inline src="/edge-theme/assets/built/main.min.js"></script>
	</body>
</html>
