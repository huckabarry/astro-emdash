---
import Base from "../../layouts/Base.astro";
import { env } from "cloudflare:workers";
import { getStatuses, hasStatusEditCredentials } from "../../lib/status";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect("/_emdash/admin/login?redirect=/status-admin");
}

const statuses = await getStatuses(env, { limit: 30, includeReplies: true });
const canEdit = hasStatusEditCredentials(env);

const ok = Astro.url.searchParams.get("ok");
const message = Astro.url.searchParams.get("message");

function formatDate(value: Date) {
	return value.toLocaleString();
}
---

<Base title="Status Admin" description="PDS-backed status editor for the Afterword Astro lab.">
	<section class="status-admin">
		<div class="status-admin__hero">
			<p class="status-admin__eyebrow">PDS-native</p>
			<h1>Status Admin</h1>
			<p class="status-admin__lede">
				These posts are read from Bluesky and edited directly on your PDS. The lab is just the
				front end.
			</p>
		</div>

		{message && (
			<p class:list={["status-admin__flash", ok === "1" ? "status-admin__flash--ok" : "status-admin__flash--error"]}>
				{message}
			</p>
		)}

		{!canEdit && (
			<div class="status-admin__notice">
				<h2>Editing is almost wired</h2>
				<p>
					This lab can already read your PDS-backed status posts, but save/delete needs worker
					secrets for <code>STANDARD_SITE_APP_PASSWORD</code> and a login identifier like
					<code>STANDARD_SITE_LOGIN_IDENTIFIER</code>.
				</p>
			</div>
		)}

		<ul class="status-admin__list">
			{statuses.map((post) => (
				<li class="status-admin__card">
					<div class="status-admin__meta">
						<div class="status-admin__meta-left">
							{post.avatar ? (
								<img class="status-admin__avatar" src={post.avatar} alt={post.displayName} />
							) : (
								<div class="status-admin__avatar status-admin__avatar--placeholder"></div>
							)}
							<div>
								<div class="status-admin__authorline">
									<strong>{post.displayName}</strong>
									<span>{post.handle}</span>
									{post.isReply && <span class="status-admin__reply-badge">Reply</span>}
								</div>
								<div class="status-admin__subline">
									<span>{formatDate(post.date)}</span>
									<a href={post.blueskyUrl} target="_blank" rel="noreferrer">Open on Bluesky</a>
								</div>
							</div>
						</div>
						<div class="status-admin__metrics">
							<span>{post.replyCount} replies</span>
							<span>{post.repostCount} reposts</span>
							<span>{post.likeCount} likes</span>
						</div>
					</div>

					<form class="status-admin__editor" method="POST" action="/status-admin/update">
						<input type="hidden" name="uri" value={post.uri} />
						<label for={`status-${post.slug}`}>Edit text</label>
						<textarea
							id={`status-${post.slug}`}
							name="text"
							rows="5"
							disabled={!canEdit}
						>{post.text}</textarea>
						<p class="status-admin__note">
							Like your current site, editing clears Bluesky link and mention facets, so plain
							text is safest.
						</p>
						<div class="status-admin__actions">
							<button type="submit" disabled={!canEdit}>Save changes</button>
						</div>
					</form>

					{post.images.length > 0 && (
						<div class="status-admin__media-strip">
							{post.images.map((image) => (
								<img src={image.thumb || image.fullsize} alt={image.alt || "Status image"} loading="lazy" />
							))}
						</div>
					)}

					<form class="status-admin__delete" method="POST" action="/status-admin/delete">
						<input type="hidden" name="uri" value={post.uri} />
						<button type="submit" disabled={!canEdit}>Delete post</button>
					</form>
				</li>
			))}
		</ul>
	</section>
</Base>

<style>
	.status-admin {
		max-width: 56rem;
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	.status-admin__hero {
		margin-bottom: 2rem;
	}

	.status-admin__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent, #7f8c8d);
	}

	.status-admin__hero h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.25rem);
	}

	.status-admin__lede {
		max-width: 42rem;
		margin: 0.65rem 0 0;
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.status-admin__flash,
	.status-admin__notice {
		margin: 0 0 1.5rem;
		padding: 1rem 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-card);
	}

	.status-admin__flash--ok {
		border-color: color-mix(in srgb, #59b37a 45%, var(--color-border));
	}

	.status-admin__flash--error {
		border-color: color-mix(in srgb, #d97b7b 45%, var(--color-border));
	}

	.status-admin__notice h2 {
		margin: 0 0 0.35rem;
		font-size: 1.05rem;
	}

	.status-admin__notice p {
		margin: 0;
		line-height: 1.65;
		color: var(--color-muted);
	}

	.status-admin__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1.5rem;
	}

	.status-admin__card {
		padding: 1.2rem;
		border: 1px solid var(--color-border);
		border-radius: 1.25rem;
		background: var(--color-card);
	}

	.status-admin__meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.status-admin__meta-left {
		display: flex;
		gap: 0.85rem;
	}

	.status-admin__avatar {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		object-fit: cover;
		background: var(--color-border);
	}

	.status-admin__avatar--placeholder {
		background: linear-gradient(135deg, var(--color-border), transparent);
	}

	.status-admin__authorline,
	.status-admin__subline,
	.status-admin__metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		align-items: center;
	}

	.status-admin__authorline strong {
		font-size: 1rem;
	}

	.status-admin__authorline span,
	.status-admin__subline span,
	.status-admin__subline a,
	.status-admin__metrics span {
		font-size: 0.88rem;
		color: var(--color-muted);
	}

	.status-admin__reply-badge {
		padding: 0.15rem 0.5rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-border) 55%, transparent);
	}

	.status-admin__editor {
		display: grid;
		gap: 0.55rem;
	}

	.status-admin__editor label {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-accent, #7f8c8d);
	}

	.status-admin__editor textarea {
		width: 100%;
		min-height: 6.75rem;
		padding: 0.85rem 0.95rem;
		border-radius: 0.95rem;
		border: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-card) 86%, black 14%);
		color: var(--color-text);
		font: inherit;
		line-height: 1.55;
		resize: vertical;
	}

	.status-admin__editor textarea:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	.status-admin__note {
		margin: 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.status-admin__actions,
	.status-admin__delete {
		display: flex;
		justify-content: flex-start;
		margin-top: 0.25rem;
	}

	.status-admin__actions button,
	.status-admin__delete button {
		padding: 0.6rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-text);
		font: inherit;
		cursor: pointer;
	}

	.status-admin__delete button {
		color: #d38f8f;
		border-color: color-mix(in srgb, #d97b7b 45%, var(--color-border));
	}

	.status-admin__actions button:disabled,
	.status-admin__delete button:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.status-admin__media-strip {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.status-admin__media-strip img {
		width: 7rem;
		height: 7rem;
		border-radius: 0.9rem;
		object-fit: cover;
		background: var(--color-border);
	}

	@media (max-width: 760px) {
		.status-admin__meta {
			flex-direction: column;
		}
	}
</style>
