---
import { getTerm, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import {
	PUBLIC_ARCHIVE_CACHE_CONTROL,
	fallbackTagLabel,
	getPostTagSlugs,
} from "../../lib/emdash-content";

Astro.response.headers.set("Cache-Control", PUBLIC_ARCHIVE_CACHE_CONTROL);

const { slug } = Astro.params;
const term = slug ? await getTerm("category", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);

const uniqueTagSlugs = [...new Set(posts.flatMap((post) => getPostTagSlugs(post)))];
const tagEntries = await Promise.all(
	uniqueTagSlugs.map(async (tagSlug) => [tagSlug, await getTerm("tag", tagSlug)] as const),
);
const tagMap = new Map(
	tagEntries.map(([tagSlug, entry]) => [
		tagSlug,
		{ slug: tagSlug, label: entry?.label || fallbackTagLabel(tagSlug) },
	]),
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: getPostTagSlugs(post).map(
		(tagSlug) => tagMap.get(tagSlug) ?? { slug: tagSlug, label: fallbackTagLabel(tagSlug) },
	),
}));
---

<Base title={`${term.label} posts`} description={`All posts in ${term.label}`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Category</span>
			<h1 class="section-title">{term.label}</h1>
			<p class="archive-count">
				{filteredPosts.length}
				{filteredPosts.length === 1 ? "post" : "posts"}
			</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">No posts in this category yet.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 0 var(--spacing-8);
	}

	.archive-header {
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-5);
		border-bottom: 1px solid var(--color-border);
	}

	.archive-label {
		display: block;
		font-size: 0.76rem;
		font-weight: 500;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-style: italic;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: 0.92rem;
		font-family: var(--font-mono);
		font-style: italic;
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-6);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
