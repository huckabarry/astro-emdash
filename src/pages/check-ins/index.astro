---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { getCheckinsPage } from "../../lib/checkins";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=30, s-maxage=60, stale-while-revalidate=300");

const initialPage = await getCheckinsPage(env, { limit: 20 });

function formatDate(value: Date) {
	return value.toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	});
}

function excerpt(value: string, maxLength = 220) {
	const normalized = String(value || "").trim().replace(/\s+/g, " ");
	if (!normalized || normalized.length <= maxLength) {
		return normalized;
	}
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
}
---

<Base title="Check-ins" description="Places I’ve saved along the way, with notes, maps, and a little context for why they mattered.">
	<section class="page-head">
		<h1 class="section-title">Check-ins</h1>
		<p class="page-head__lede">
			Places I’ve saved along the way, with notes, maps, and a little context for why they mattered.
		</p>
	</section>

	<section class="list">
		{initialPage.items.map((item) => (
			<article class="card surface">
				{item.canonicalPath && (
					<a class="card__overlay-link" href={item.canonicalPath} aria-label={`Open check-in for ${item.name}`}>
						<span class="sr-only">Open {item.name}</span>
					</a>
				)}
				<div class="card__link-wrap">
					{item.mapPreviewPath && (
						<div class="card__map">
							<img
								class="card__map-image"
								src={item.mapPreviewPath}
								alt={`Map preview for ${item.name}`}
								loading="lazy"
								decoding="async"
								width="640"
								height="400"
							/>
						</div>
					)}
					<div class="card__copy">
						<div class="card__meta">
							<time datetime={item.visitedAt.toISOString()}>{formatDate(item.visitedAt)}</time>
							{item.visibility && item.visibility !== "public" && (
								<span class="card__meta-pill">{item.visibility}</span>
							)}
							{!item.imported && <span class="card__meta-pill">live</span>}
						</div>
						<h2 class="card__title">
							{item.canonicalPath ? (
								<a class="card__title-link" href={item.canonicalPath}>{item.name}</a>
							) : (
								item.name
							)}
						</h2>
						{item.place && <p class="card__place">{item.place}</p>}
						{item.venueCategory && <p class="card__kicker">{item.venueCategory}</p>}
						{(item.note || item.excerpt) && (
							<p class="card__excerpt">{excerpt(item.excerpt || item.note, 220)}</p>
						)}
					</div>
				</div>
			</article>
			))}
		</section>

		<div
			class="list-sentinel"
			data-checkins-sentinel
			data-next-cursor={initialPage.nextCursor || ""}
			aria-hidden="true"
		></div>
	</Base>

<script>
	const list = document.querySelector(".list");
	const sentinel = document.querySelector("[data-checkins-sentinel]");

	function resolveAstroCidAttrName(root) {
		if (!(root instanceof Element)) return null;
		const sample = root.querySelector("article") || root;
		for (const attr of Array.from(sample.attributes)) {
			if (attr.name.startsWith("data-astro-cid-")) return attr.name;
		}
		return null;
	}

	function stampAstroCid(fragment, cidAttrName) {
		if (!cidAttrName || !fragment) return;
		const nodes = fragment.querySelectorAll ? fragment.querySelectorAll("*") : [];
		for (const node of Array.from(nodes)) {
			if (node instanceof Element) node.setAttribute(cidAttrName, "");
		}
	}

	function escapeHtml(value) {
		return String(value || "")
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#39;");
	}

	function formatDate(value) {
		return new Date(value).toLocaleDateString("en-US", {
			month: "short",
			day: "numeric",
			year: "numeric",
		});
	}

	function excerpt(value, maxLength = 220) {
		const normalized = String(value || "").trim().replace(/\s+/g, " ");
		if (!normalized || normalized.length <= maxLength) {
			return normalized;
		}
		return `${normalized.slice(0, maxLength).trimEnd()}…`;
	}

	function renderCheckinCard(item) {
		const detailHref = item.canonicalPath || "";
		const metaPills = [
			item.visibility && item.visibility !== "public"
				? `<span class="card__meta-pill">${escapeHtml(item.visibility)}</span>`
				: "",
			!item.imported ? '<span class="card__meta-pill">live</span>' : "",
		]
			.filter(Boolean)
			.join("");

		return `
			<article class="card surface">
				${detailHref ? `<a class="card__overlay-link" href="${escapeHtml(detailHref)}" aria-label="Open check-in for ${escapeHtml(item.name)}"><span class="sr-only">Open ${escapeHtml(item.name)}</span></a>` : ""}
				<div class="card__link-wrap">
					${item.mapPreviewPath ? `<div class="card__map"><img class="card__map-image" src="${escapeHtml(item.mapPreviewPath)}" alt="Map preview for ${escapeHtml(item.name)}" loading="lazy" decoding="async" width="640" height="400" /></div>` : ""}
					<div class="card__copy">
						<div class="card__meta">
							<time datetime="${escapeHtml(item.visitedAt)}">${escapeHtml(formatDate(item.visitedAt))}</time>
							${metaPills}
						</div>
						<h2 class="card__title">
							${detailHref ? `<a class="card__title-link" href="${escapeHtml(detailHref)}">${escapeHtml(item.name)}</a>` : escapeHtml(item.name)}
						</h2>
						${item.place ? `<p class="card__place">${escapeHtml(item.place)}</p>` : ""}
						${item.venueCategory ? `<p class="card__kicker">${escapeHtml(item.venueCategory)}</p>` : ""}
						${item.note || item.excerpt ? `<p class="card__excerpt">${escapeHtml(excerpt(item.excerpt || item.note, 220))}</p>` : ""}
					</div>
				</div>
			</article>
		`;
	}

	if (list instanceof HTMLElement && sentinel instanceof HTMLElement) {
		const cidAttrName = resolveAstroCidAttrName(list);
		let nextCursor = sentinel.dataset.nextCursor || "";
		let loading = false;

		const loadMore = async () => {
			if (!nextCursor || loading) {
				return;
			}

			loading = true;

			try {
				const response = await fetch(`/check-ins/page.json?cursor=${encodeURIComponent(nextCursor)}&limit=20`, {
					headers: { accept: "application/json" },
				});

				if (!response.ok) {
					return;
				}

				const payload = await response.json();
				const items = Array.isArray(payload?.items) ? payload.items : [];

				for (const item of items) {
					const template = document.createElement("template");
					template.innerHTML = renderCheckinCard(item);
					stampAstroCid(template.content, cidAttrName);
					list.appendChild(template.content);
				}

				nextCursor = String(payload?.nextCursor || "");
				sentinel.dataset.nextCursor = nextCursor;

				if (!nextCursor) {
					observer.disconnect();
					sentinel.remove();
				}
			} finally {
				loading = false;
			}
		};

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					void loadMore();
				}
			},
			{ rootMargin: "240px 0px" },
		);

		if (nextCursor) {
			observer.observe(sentinel);
		} else {
			sentinel.remove();
		}
	}
</script>

<style>
	.page-head {
		margin-bottom: 1.2rem;
	}

	.list {
		display: grid;
		gap: 1.5rem;
	}

	.card {
		display: grid;
		position: relative;
		min-width: 0;
		padding-bottom: 1.2rem;
		content-visibility: auto;
		contain-intrinsic-size: 520px;
	}

	.card::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		border-bottom: 1px dotted color-mix(in srgb, var(--border) 72%, transparent);
		opacity: 0.6;
	}

	.card__link-wrap {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		text-decoration: none;
		align-items: stretch;
	}

	.card__overlay-link {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: 1rem;
	}

	.card__overlay-link:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.card__copy {
		display: grid;
		min-width: 0;
		align-content: start;
		gap: 0.7rem;
		padding: 0.3rem 0;
	}

	.card__map {
		display: block;
		overflow: hidden;
		border-radius: 1rem;
		aspect-ratio: 16 / 10;
		background: color-mix(in srgb, var(--surface) 82%, white 18%);
	}

	.card__map-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card__meta {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		gap: 0.5rem 0.9rem;
		font-size: 0.82rem;
		color: var(--accent);
		align-items: center;
	}

	.card__meta-pill {
		padding: 0.18rem 0.55rem;
		border-radius: 999px;
		border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		color: var(--muted);
		text-transform: capitalize;
	}

	.card__title {
		margin: 0;
		min-width: 0;
		font-size: clamp(1.35rem, 2vw, 1.75rem);
		line-height: 1.08;
		color: #ffffff;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.card__title-link {
		position: relative;
		z-index: 2;
		color: inherit;
		text-decoration: none;
	}

	.card__place {
		margin: 0;
		min-width: 0;
		font-size: 1rem;
		line-height: 1.45;
		color: #d7d8d4;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.card__kicker {
		margin: 0.1rem 0 0;
		min-width: 0;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.76rem;
		font-weight: 700;
	}

	.card__excerpt {
		margin: 0.35rem 0 0;
		min-width: 0;
		color: var(--muted);
		line-height: 1.65;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.list-sentinel {
		height: 1px;
	}

	@media (max-width: 640px) {
		.card__map {
			display: none;
		}
	}

	@media (min-width: 720px) {
		.card__link-wrap {
			grid-template-columns: minmax(10.5rem, 12rem) minmax(0, 1fr);
			gap: 1.25rem;
			align-items: start;
		}

		.card__map {
			aspect-ratio: 1 / 1;
			max-height: 12rem;
			align-self: start;
		}
	}
</style>
