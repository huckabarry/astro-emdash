---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { getCheckins } from "../../lib/checkins";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300, stale-while-revalidate=86400");

const checkins = await getCheckins(env);

function formatDate(value: Date) {
	return value.toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	});
}

function excerpt(value: string, maxLength = 220) {
	const normalized = String(value || "").trim().replace(/\s+/g, " ");
	if (!normalized || normalized.length <= maxLength) {
		return normalized;
	}
	return `${normalized.slice(0, maxLength).trimEnd()}…`;
}
---

<Base title="Check-ins" description="Places, notes, and little map-backed records pulled from the PDS check-in stream.">
	<section class="checkins-page">
		<header class="checkins-page__hero">
			<p class="checkins-page__eyebrow">PDS-backed</p>
			<h1>Check-ins</h1>
			<p class="checkins-page__lede">
				Places I’ve saved along the way, with notes, maps, and a little context for why they mattered.
			</p>
		</header>

		{checkins.length ? (
			<ol class="checkins-page__list">
				{checkins.map((item) => (
					<li class="checkin-card">
						<div class="checkin-card__meta">
							<time datetime={item.visitedAt.toISOString()}>{formatDate(item.visitedAt)}</time>
							{item.visibility !== "public" && <span class="checkin-card__pill">{item.visibility}</span>}
							{item.venueCategory && <span>{item.venueCategory}</span>}
						</div>
						<h2><a href={`/check-ins/${item.slug}`}>{item.name}</a></h2>
						{item.place && <p class="checkin-card__place">{item.place}</p>}
						{(item.excerpt || item.note) && (
							<p class="checkin-card__excerpt">{excerpt(item.excerpt || item.note)}</p>
						)}
						<div class="checkin-card__actions">
							<a href={`/check-ins/${item.slug}`}>Open check-in</a>
							{item.website && <a href={item.website} target="_blank" rel="noreferrer">Visit place</a>}
							{item.appleMapsUrl && (
								<a href={item.appleMapsUrl} target="_blank" rel="noreferrer">Apple Maps</a>
							)}
						</div>
					</li>
				))}
			</ol>
		) : (
			<div class="checkins-page__empty">
				<h2>No check-ins yet</h2>
				<p>When public check-ins exist on the PDS, they’ll appear here.</p>
			</div>
		)}
	</section>
</Base>

<style>
	.checkins-page {
		max-width: 52rem;
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	.checkins-page__hero {
		margin-bottom: 2rem;
	}

	.checkins-page__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent, #7f8c8d);
	}

	.checkins-page__hero h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.4rem);
	}

	.checkins-page__lede {
		max-width: 40rem;
		margin: 0.7rem 0 0;
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--color-muted);
	}

	.checkins-page__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1.25rem;
	}

	.checkin-card {
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 1.25rem;
		background: var(--color-card);
	}

	.checkin-card__meta,
	.checkin-card__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0.8rem;
		align-items: center;
	}

	.checkin-card__meta {
		margin-bottom: 0.75rem;
		font-size: 0.84rem;
		color: var(--color-muted);
	}

	.checkin-card__pill {
		padding: 0.18rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		text-transform: capitalize;
	}

	.checkin-card h2 {
		margin: 0;
		font-size: clamp(1.35rem, 2vw, 1.75rem);
	}

	.checkin-card h2 a {
		color: inherit;
		text-decoration: none;
	}

	.checkin-card__place,
	.checkin-card__excerpt {
		margin: 0.6rem 0 0;
		line-height: 1.65;
		color: var(--color-muted);
	}

	.checkin-card__actions {
		margin-top: 1rem;
	}

	.checkin-card__actions a {
		color: inherit;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.14em;
	}

	.checkins-page__empty {
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 1.25rem;
		background: var(--color-card);
	}
</style>
