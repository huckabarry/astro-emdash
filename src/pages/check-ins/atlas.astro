---
import { env } from "cloudflare:workers";
import CheckinAtlasMap from "../../components/CheckinAtlasMap.astro";
import Base from "../../layouts/Base.astro";
import { getCheckins } from "../../lib/checkins";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300, stale-while-revalidate=900");

const checkins = await getCheckins(env as unknown as Record<string, unknown>);
const mappedCheckins = checkins
	.filter((item) => Number.isFinite(item.latitude) && Number.isFinite(item.longitude))
	.slice(0, 50)
	.map((item) => ({
		slug: item.slug,
		name: item.name,
		place: item.place,
		visitedAt: item.visitedAt.toISOString(),
		visitedAtLabel: item.visitedAt.toLocaleDateString("en-US", {
			month: "short",
			day: "numeric",
			year: "numeric",
		}),
		latitude: item.latitude,
		longitude: item.longitude,
		href: item.canonicalPath,
	}));
---

<Base
	title="Check-in Atlas"
	description="An experimental map of the most recent check-ins saved to Afterword."
>
	<section class="page-head">
		<h1 class="section-title">Check-in Atlas</h1>
		<p class="page-head__lede">
			The latest fifty check-ins on one map.
		</p>
	</section>

	<section class="atlas">
		<div class="atlas__map">
			<CheckinAtlasMap items={mappedCheckins} />
		</div>

		<div class="atlas__summary">
			<p class="atlas__count">{mappedCheckins.length} recent check-ins with coordinates</p>
			<p class="atlas__note">
				This page is intentionally unlinked for now. Open a marker to jump into a specific check-in.
			</p>
		</div>
	</section>
</Base>

<style>
	.page-head {
		margin-bottom: 1.2rem;
	}

	.atlas {
		display: grid;
		gap: 1rem;
	}

	.atlas__map {
		--checkin-map-height: clamp(24rem, 70vh, 42rem);
	}

	.atlas__summary {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		align-items: baseline;
		color: var(--muted);
	}

	.atlas__count {
		margin: 0;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.9rem;
	}

	.atlas__note {
		margin: 0;
		font-size: 0.92rem;
	}

	:global(.atlas-popup) {
		display: grid;
		gap: 0.18rem;
	}

	:global(.atlas-popup a) {
		color: inherit;
		text-decoration: none;
	}

	:global(.atlas-popup__place),
	:global(.atlas-popup__date) {
		color: #5e625b;
		font-size: 0.84rem;
		line-height: 1.35;
	}
	@media (max-width: 640px) {
		.atlas__map {
			--checkin-map-height: 62vh;
		}
	}
</style>
