---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import CheckinMap from "../../components/CheckinMap.astro";
import { getCheckinBySlug, getCheckins } from "../../lib/checkins";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300, stale-while-revalidate=86400");

const slug = String(Astro.params.slug || "");
const checkins = await getCheckins(env);
const item = await getCheckinBySlug(env, slug);

if (!item) {
	return Astro.redirect("/404");
}

const currentIndex = checkins.findIndex((entry) => entry.slug === slug);
const previousItem = currentIndex >= 0 ? checkins[currentIndex + 1] || null : null;
const nextItem = currentIndex >= 0 ? checkins[currentIndex - 1] || null : null;

function formatDate(value: Date) {
	return value.toLocaleDateString("en-US", {
		month: "long",
		day: "numeric",
		year: "numeric",
	});
}
---

<Base
	title={`${item.name} | Check-ins`}
	description={[item.note || item.excerpt, item.place].filter(Boolean).join(" · ") || `Check-in at ${item.name}`}
>
	<article class="entry entry--checkin">
		<div class="entry__meta">
			<a href="/check-ins">Check-ins</a>
			<time datetime={item.visitedAt.toISOString()}>{formatDate(item.visitedAt)}</time>
			{item.place && <span>{item.place}</span>}
		</div>

		<h1 class="entry__title">{item.name}</h1>

		{item.latitude !== null && item.longitude !== null && (
			<section class="checkin-map" aria-label="Map">
				<CheckinMap latitude={item.latitude} longitude={item.longitude} name={item.name} />
				<div class="checkin-map__actions">
					{item.appleMapsUrl && <a class="post-action-link" href={item.appleMapsUrl} target="_blank" rel="noreferrer">Open in Apple Maps</a>}
					{item.latitude !== null && item.longitude !== null && (
						<a
							class="post-action-link"
							href={`https://www.openstreetmap.org/?mlat=${item.latitude}&mlon=${item.longitude}#map=14/${item.latitude}/${item.longitude}`}
							target="_blank"
							rel="noreferrer"
						>
							Open in OpenStreetMap
						</a>
					)}
				</div>
			</section>
		)}

		{item.coverImage && (
			<figure class="entry__figure">
				<img src={item.coverImage} alt={item.name} loading="eager" />
			</figure>
		)}

		{item.photoUrls.length > 1 && (
			<section class="checkin-gallery" aria-label="More photos">
				{item.photoUrls
					.filter((photo) => photo !== item.coverImage)
					.map((photo) => <img class="checkin-gallery__image" src={photo} alt={item.name} loading="lazy" />)}
			</section>
		)}

		{item.note && <div class="entry__content"><p>{item.note}</p></div>}

		<dl class="checkin-detail__meta">
			{item.address && (
				<div>
					<dt>Address</dt>
					<dd>{item.address}</dd>
				</div>
			)}
			{item.venueCategory && (
				<div>
					<dt>Category</dt>
					<dd>{item.venueCategory}</dd>
				</div>
			)}
			{item.visibility !== "public" && (
				<div>
					<dt>Visibility</dt>
					<dd>{item.visibility}</dd>
				</div>
			)}
		</dl>

		{item.tags.length ? (
			<div class="checkin-card__tags">
				{item.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
			</div>
		) : null}

		<footer class="post-actions">
			{item.website && <a class="post-action-link" href={item.website} target="_blank" rel="noreferrer">Visit place website</a>}
			<a class="post-action-link" href="/check-ins">Back to all check-ins</a>
		</footer>

		{previousItem || nextItem ? (
			<nav class="post-navigation">
				<ul>
					<li class="post-navigation-item post-navigation-item-previous">
						{previousItem ? (
							<a class="post-navigation-link" href={`/check-ins/${previousItem.slug}`}>
								<span class="post-navigation-label">← Previous</span>
								<span class="post-navigation-title">{previousItem.name}</span>
							</a>
						) : null}
					</li>
					<li class="post-navigation-item post-navigation-item-next">
						{nextItem ? (
							<a class="post-navigation-link" href={`/check-ins/${nextItem.slug}`}>
								<span class="post-navigation-label">Next →</span>
								<span class="post-navigation-title">{nextItem.name}</span>
							</a>
						) : null}
					</li>
				</ul>
			</nav>
		) : null}
	</article>
</Base>

<style>
	.entry--checkin {
		display: grid;
		gap: 1rem;
	}
</style>
