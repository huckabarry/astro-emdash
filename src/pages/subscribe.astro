---
import Base from "../layouts/Base.astro";

const siteUrl = "https://afterword.blog";
const feeds = [
	{
		title: "Everything",
		description: "The full public stream from Afterword: writing, status, media, check-ins, and archive posts.",
		rssUrl: "/everything/feed.xml",
		jsonUrl: "/everything/feed.json",
	},
	{
		title: "Writing",
		description: "Field notes, planning posts, and other longer writing from Afterword.",
		rssUrl: "/feed.xml",
		jsonUrl: "/feed.json",
	},
	{
		title: "Planning",
		description: "Planning and urbanism posts only.",
		rssUrl: "/planning/feed.xml",
		jsonUrl: "/planning/feed.json",
	},
	{
		title: "Status",
		description: "Short updates pulled from Bluesky into the site.",
		rssUrl: "/status/feed.xml",
		jsonUrl: "/status/feed.json",
	},
	{
		title: "Media",
		description: "Albums, songs, books, movies, and shows from the media timeline.",
		rssUrl: "/media/feed.xml",
		jsonUrl: "/media/feed.json",
	},
];

const microblogFeeds = [
	{
		title: "Writing JSON Feed",
		description: "Longer posts with titles, summaries, full HTML, and inline images.",
		url: `${siteUrl}/feed.json`,
	},
	{
		title: "Status JSON Feed",
		description: "Micro posts without fake titles, with inline photos and media.",
		url: `${siteUrl}/status/feed.json`,
	},
	{
		title: "Media JSON Feed",
		description: "Listening and watching entries with artwork inside the post content.",
		url: `${siteUrl}/media/feed.json`,
	},
	{
		title: "Everything JSON Feed",
		description: "The full public stream, mixing long posts and micro posts.",
		url: `${siteUrl}/everything/feed.json`,
	},
];
---

<Base
	title="Subscribe"
	description="Follow Afterword by RSS or JSON feed, with options for writing, planning, status, media, and the full public stream."
>
	<section class="section-block">
		<h1 class="section-title">Subscribe</h1>
		<article class="content content-page">
			<div class="post-full-content">
				<section class="content-body subscribe-page">
					<p>
						The cleanest way to follow Afterword right now is from your own reader. RSS is
						usually the safest choice, but I’ve included JSON feeds too.
					</p>

					<section class="subscribe-microblog">
						<h2>Micro.blog Imports</h2>
						<p>
							If you’re importing Afterword into Micro.blog, these JSON Feed URLs are the
							best starting point. Writing and Status are the cleanest pair.
						</p>
						<div class="subscribe-copy-list">
							{microblogFeeds.map((feed) => (
								<section class="subscribe-copy-card">
									<h3>{feed.title}</h3>
									<p>{feed.description}</p>
									<input class="subscribe-copy-input" type="text" readonly value={feed.url} />
								</section>
							))}
						</div>
					</section>

					<div class="subscribe-feed-list">
						{feeds.map((feed) => (
							<section class="subscribe-feed-card">
								<h2>{feed.title}</h2>
								<p>{feed.description}</p>
								<div class="subscribe-feed-links">
									<a href={feed.rssUrl}>RSS</a>
									<a href={feed.jsonUrl}>JSON</a>
								</div>
							</section>
						))}
					</div>
				</section>
			</div>
		</article>
	</section>
</Base>

<style>
	.subscribe-page {
		display: grid;
		gap: 2rem;
	}

	.subscribe-feed-list {
		display: grid;
		gap: 1rem;
	}

	.subscribe-microblog {
		display: grid;
		gap: 1rem;
	}

	.subscribe-microblog h2 {
		margin: 0;
	}

	.subscribe-copy-list {
		display: grid;
		gap: 1rem;
	}

	.subscribe-copy-card {
		padding: 1.1rem 1.2rem;
		border: 1px solid rgba(245, 241, 171, 0.18);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.subscribe-copy-card h3 {
		margin: 0 0 0.45rem;
		font-size: 1rem;
	}

	.subscribe-copy-card p {
		margin: 0 0 0.85rem;
	}

	.subscribe-copy-input {
		width: 100%;
		padding: 0.7rem 0.8rem;
		border: 1px solid rgba(245, 241, 171, 0.18);
		border-radius: 0.45rem;
		background: rgba(0, 0, 0, 0.2);
		color: inherit;
		font: inherit;
		font-family: var(--font-mono, "IBM Plex Mono", monospace);
	}

	.subscribe-feed-card {
		padding: 1.1rem 1.2rem;
		border: 1px solid rgba(245, 241, 171, 0.18);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.02);
	}

	.subscribe-feed-card h2 {
		margin: 0 0 0.45rem;
		font-size: 1.05rem;
	}

	.subscribe-feed-card p {
		margin: 0;
	}

	.subscribe-feed-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		margin-top: 0.85rem;
		font-family: var(--font-mono, "IBM Plex Mono", monospace);
		font-size: 0.92rem;
	}

	.subscribe-feed-links a {
		font-weight: 600;
	}
</style>
