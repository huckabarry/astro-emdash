---
import Base from "../../layouts/Base.astro";
import { getMediaTimelinePage, type MediaTimelineItem } from "../../lib/media";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300, stale-while-revalidate=86400");

const timelinePage = await getMediaTimelinePage(0, 8);
const items = timelinePage.items;

function usesPosterRatio(item: MediaTimelineItem) {
	return item.kind === "popfeed" && (item.mediaType === "movie" || item.mediaType === "tv_show");
}

function isBookPopfeed(item: MediaTimelineItem) {
	return item.kind === "popfeed" && item.mediaType === "book";
}
---

<Base title="Media" description="Albums, songs, books, movies, and shows folded into one timeline.">
	<section class="section-block">
		<h1 class="section-title">Media</h1>
		<article class="content content-page">
			<div class="post-full-content">
				<section class="content-body">
					<p>
						Albums, songs, books, movies, and shows folded into one timeline, fetched directly from the
						source services and personal data records that power this corner of the site.
					</p>
				</section>
			</div>
		</article>
	</section>

	{items.length ? (
		<section class="section-block">
			<div class="media-timeline" aria-label="Media timeline">
				{items.map((item) => (
					<article class="media-timeline__entry" id={item.id}>
						<div class="media-timeline__meta-column">
							<time class="media-timeline__date" datetime={item.dateIso}>
								{item.dateLabel}
							</time>
						</div>

						<div class="media-timeline__rail" aria-hidden="true">
							<span class="media-timeline__dot"></span>
						</div>

						<div class="media-timeline__content">
							<p class="media-timeline__kicker">{item.label}</p>

							{item.tags.length ? (
								<div class="media-timeline__tags">
									{item.tags.map((tag) => <span class="tag-pill">{tag}</span>)}
								</div>
							) : null}

							{item.kind === "track" ? (
								<div class="media-entry media-entry--track">
									<a class="media-entry__cover media-entry__cover--mini" href={item.href}>
										{item.imageUrl ? (
											<img class="media-entry__art media-entry__art--mini" src={item.imageUrl} alt={item.imageAlt || item.title} loading="lazy" />
										) : (
											<div class="media-entry__fallback media-entry__fallback--mini" aria-hidden="true">Track</div>
										)}
									</a>

									<div class="media-entry__mini-player">
									<div class="media-entry__body">
										<div class="media-entry__heading">
											<h2 class="media-timeline__title media-timeline__title--media media-timeline__title--mini">
												<a href={item.href}>{item.title}</a>
											</h2>
										</div>

											<p class="media-timeline__meta media-timeline__meta--artist">{item.artist}</p>
										</div>

										{item.audioUrl ? (
											<div class="media-entry__audio media-entry__audio--mini">
												<audio controls preload="none" src={item.audioUrl} aria-label={`Preview ${item.title}`}></audio>
											</div>
										) : null}

										{item.summary ? (
											<p class="media-timeline__lede media-timeline__lede--compact media-timeline__lede--mini">
												{item.summary}
											</p>
										) : null}

										{item.links.length ? (
											<div class="media-timeline__actions media-timeline__actions--mini">
												{item.links.map((link) => (
													<a
														class="tag-pill media-timeline__action"
														href={link.url}
														target={link.external ? "_blank" : undefined}
														rel={link.external ? "noreferrer" : undefined}
													>
														{link.label}
													</a>
												))}
											</div>
										) : null}
									</div>
								</div>
							) : item.kind === "popfeed" ? (
								<div class="media-entry media-entry--popfeed">
									<div class="media-entry__body">
										<div class="media-entry__heading">
											<h2 class="media-timeline__title media-timeline__title--media">
												<a href={item.href}>{item.title}</a>
											</h2>
										</div>

										{item.credit ? <p class="media-timeline__meta media-timeline__meta--artist">{item.credit}</p> : null}
										{item.activityLabel ? (
											<p class="media-timeline__meta media-timeline__meta--status">Latest update: {item.activityLabel}</p>
										) : null}
									</div>

									{!isBookPopfeed(item) ? (
										<a
											class:list={[
												"media-entry__cover",
												"media-entry__cover--full",
												usesPosterRatio(item) ? "media-entry__cover--poster" : "media-entry__cover--natural",
											]}
											href={item.href}
										>
											{item.imageUrl ? (
												<img
													class:list={[
														"media-entry__art",
														usesPosterRatio(item) ? "media-entry__art--poster" : "media-entry__art--natural",
													]}
													src={item.imageUrl}
													alt={item.imageAlt || item.title}
													loading="lazy"
												/>
											) : (
												<div
													class:list={[
														"media-entry__fallback",
														usesPosterRatio(item) ? "media-entry__fallback--poster" : "media-entry__fallback--natural",
													]}
													aria-hidden="true"
												>
													{item.label}
												</div>
											)}
										</a>
									) : null}

									{item.summary ? <p class="media-timeline__lede media-timeline__lede--compact">{item.summary}</p> : null}

									<div class="media-timeline__actions">
										<a class="tag-pill media-timeline__action" href={item.href}>Open entry</a>
										{item.links.map((link) => (
											<a
												class="tag-pill media-timeline__action"
												href={link.url}
												target={link.external ? "_blank" : undefined}
												rel={link.external ? "noreferrer" : undefined}
											>
												{link.label}
											</a>
										))}
									</div>
								</div>
							) : (
								<div class="media-entry media-entry--album">
									<div class="media-entry__body">
										<div class="media-entry__heading">
											<h2 class="media-timeline__title media-timeline__title--media">
												<a href={item.href}>{item.title}</a>
											</h2>
										</div>

										<p class="media-timeline__meta media-timeline__meta--artist">{item.artist}</p>
									</div>

									<a class="media-entry__cover media-entry__cover--full" href={item.href}>
										{item.imageUrl ? (
											<img class="media-entry__art" src={item.imageUrl} alt={item.imageAlt || item.title} loading="lazy" />
										) : (
											<div class="media-entry__fallback" aria-hidden="true">Album</div>
										)}
									</a>

									{item.summary ? <p class="media-timeline__lede media-timeline__lede--compact">{item.summary}</p> : null}

									{item.links.length ? (
										<div class="media-timeline__actions">
											{item.links.map((link) => (
												<a
													class="tag-pill media-timeline__action"
													href={link.url}
													target={link.external ? "_blank" : undefined}
													rel={link.external ? "noreferrer" : undefined}
												>
													{link.label}
												</a>
											))}
										</div>
									) : null}
								</div>
							)}
						</div>
					</article>
				))}
			</div>

			<div
				class="media-timeline__sentinel"
				data-media-sentinel
				data-next-offset={timelinePage.nextOffset === null ? "" : String(timelinePage.nextOffset)}
				aria-hidden="true"
			></div>
		</section>
	) : (
		<section class="section-block">
			<p class="page-head__lede">No media notes are available yet.</p>
		</section>
	)}
</Base>

<script>
	// @ts-nocheck
	const timeline = document.querySelector(".media-timeline");
	const sentinel = document.querySelector("[data-media-sentinel]");

	function resolveAstroCidAttrName(root) {
		if (!(root instanceof Element)) return null;
		const sample =
			root.querySelector(".media-timeline__entry") ||
			root.querySelector(".media-timeline__content") ||
			root;
		for (const attr of Array.from(sample.attributes)) {
			if (attr.name.startsWith("data-astro-cid-")) return attr.name;
		}
		return null;
	}

	function stampAstroCid(fragment, cidAttrName) {
		if (!cidAttrName || !fragment) return;
		const nodes = fragment.querySelectorAll ? fragment.querySelectorAll("*") : [];
		for (const node of Array.from(nodes)) {
			if (node instanceof Element) node.setAttribute(cidAttrName, "");
		}
	}

	function escapeHtml(value) {
		return String(value || "")
			.replaceAll("&", "&amp;")
			.replaceAll("<", "&lt;")
			.replaceAll(">", "&gt;")
			.replaceAll('"', "&quot;")
			.replaceAll("'", "&#39;");
	}

	function usesPosterRatio(item) {
		return item.kind === "popfeed" && (item.mediaType === "movie" || item.mediaType === "tv_show");
	}

	function isBookPopfeed(item) {
		return item.kind === "popfeed" && item.mediaType === "book";
	}

	function renderTagPills(tags) {
		if (!Array.isArray(tags) || !tags.length) {
			return "";
		}

		return `
			<div class="media-timeline__tags">
				${tags.map((tag) => `<span class="tag-pill">${escapeHtml(tag)}</span>`).join("")}
			</div>
		`;
	}

	function renderActionLinks(links, extraClass = "") {
		if (!Array.isArray(links) || !links.length) {
			return "";
		}

		return links
			.map((link) => {
				const externalAttrs = link?.external ? ' target="_blank" rel="noreferrer"' : "";
				return `<a class="tag-pill media-timeline__action" href="${escapeHtml(link?.url || "#")}"${externalAttrs}>${escapeHtml(link?.label || "Open")}</a>`;
			})
			.join("");
	}

	function renderTrackEntry(item) {
		const artwork = item.imageUrl
			? `<img class="media-entry__art media-entry__art--mini" src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(item.imageAlt || item.title)}" loading="lazy" decoding="async" />`
			: '<div class="media-entry__fallback media-entry__fallback--mini" aria-hidden="true">Track</div>';
		const audio = item.audioUrl
			? `<div class="media-entry__audio media-entry__audio--mini"><audio controls preload="none" src="${escapeHtml(item.audioUrl)}" aria-label="Preview ${escapeHtml(item.title)}"></audio></div>`
			: "";
		const summary = item.summary
			? `<p class="media-timeline__lede media-timeline__lede--compact media-timeline__lede--mini">${escapeHtml(item.summary)}</p>`
			: "";
		const actions = renderActionLinks(item.links);

		return `
			<div class="media-entry media-entry--track">
				<a class="media-entry__cover media-entry__cover--mini" href="${escapeHtml(item.href)}">
					${artwork}
				</a>

				<div class="media-entry__mini-player">
					<div class="media-entry__body">
						<div class="media-entry__heading">
							<h2 class="media-timeline__title media-timeline__title--media media-timeline__title--mini">
								<a href="${escapeHtml(item.href)}">${escapeHtml(item.title)}</a>
							</h2>
						</div>

						<p class="media-timeline__meta media-timeline__meta--artist">${escapeHtml(item.artist || "")}</p>
					</div>

					${audio}
					${summary}
					${actions ? `<div class="media-timeline__actions media-timeline__actions--mini">${actions}</div>` : ""}
				</div>
			</div>
		`;
	}

	function renderPopfeedEntry(item) {
		const posterRatio = usesPosterRatio(item);
		const image = item.imageUrl
			? `<img class="media-entry__art ${posterRatio ? "media-entry__art--poster" : "media-entry__art--natural"}" src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(item.imageAlt || item.title)}" loading="lazy" decoding="async" />`
			: `<div class="media-entry__fallback ${posterRatio ? "media-entry__fallback--poster" : "media-entry__fallback--natural"}" aria-hidden="true">${escapeHtml(item.label)}</div>`;
		const cover = isBookPopfeed(item)
			? ""
			: `
				<a class="media-entry__cover media-entry__cover--full ${posterRatio ? "media-entry__cover--poster" : "media-entry__cover--natural"}" href="${escapeHtml(item.href)}">
					${image}
				</a>
			`;
		const summary = item.summary
			? `<p class="media-timeline__lede media-timeline__lede--compact">${escapeHtml(item.summary)}</p>`
			: "";
		const actions = `<a class="tag-pill media-timeline__action" href="${escapeHtml(item.href)}">Open entry</a>${renderActionLinks(item.links)}`;

		return `
			<div class="media-entry media-entry--popfeed">
				<div class="media-entry__body">
					<div class="media-entry__heading">
						<h2 class="media-timeline__title media-timeline__title--media">
							<a href="${escapeHtml(item.href)}">${escapeHtml(item.title)}</a>
						</h2>
					</div>

					${item.credit ? `<p class="media-timeline__meta media-timeline__meta--artist">${escapeHtml(item.credit)}</p>` : ""}
					${item.activityLabel ? `<p class="media-timeline__meta media-timeline__meta--status">Latest update: ${escapeHtml(item.activityLabel)}</p>` : ""}
				</div>

				${cover}
				${summary}

				<div class="media-timeline__actions">${actions}</div>
			</div>
		`;
	}

	function renderAlbumEntry(item) {
		const image = item.imageUrl
			? `<img class="media-entry__art" src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(item.imageAlt || item.title)}" loading="lazy" decoding="async" />`
			: '<div class="media-entry__fallback" aria-hidden="true">Album</div>';
		const summary = item.summary
			? `<p class="media-timeline__lede media-timeline__lede--compact">${escapeHtml(item.summary)}</p>`
			: "";
		const actions = renderActionLinks(item.links);

		return `
			<div class="media-entry media-entry--album">
				<div class="media-entry__body">
					<div class="media-entry__heading">
						<h2 class="media-timeline__title media-timeline__title--media">
							<a href="${escapeHtml(item.href)}">${escapeHtml(item.title)}</a>
						</h2>
					</div>

					<p class="media-timeline__meta media-timeline__meta--artist">${escapeHtml(item.artist || "")}</p>
				</div>

				<a class="media-entry__cover media-entry__cover--full" href="${escapeHtml(item.href)}">
					${image}
				</a>

				${summary}
				${actions ? `<div class="media-timeline__actions">${actions}</div>` : ""}
			</div>
		`;
	}

	function renderMediaEntry(item) {
		const body =
			item.kind === "track"
				? renderTrackEntry(item)
				: item.kind === "popfeed"
					? renderPopfeedEntry(item)
					: renderAlbumEntry(item);

		return `
			<article class="media-timeline__entry" id="${escapeHtml(item.id)}">
				<div class="media-timeline__meta-column">
					<time class="media-timeline__date" datetime="${escapeHtml(item.dateIso)}">${escapeHtml(item.dateLabel)}</time>
				</div>

				<div class="media-timeline__rail" aria-hidden="true">
					<span class="media-timeline__dot"></span>
				</div>

				<div class="media-timeline__content">
					<p class="media-timeline__kicker">${escapeHtml(item.label)}</p>
					${renderTagPills(item.tags)}
					${body}
				</div>
			</article>
		`;
	}

	if (timeline instanceof HTMLElement && sentinel instanceof HTMLElement) {
		const cidAttrName = resolveAstroCidAttrName(timeline);
		let nextOffset = sentinel.dataset.nextOffset || "";
		let loading = false;

		const loadMore = async () => {
			if (!nextOffset || loading) {
				return;
			}

			loading = true;

			try {
				const response = await fetch(`/media/timeline.json?offset=${encodeURIComponent(nextOffset)}&limit=8`, {
					headers: { accept: "application/json" },
				});

				if (!response.ok) {
					return;
				}

				const payload = await response.json();
				const items = Array.isArray(payload?.items) ? payload.items : [];

				for (const item of items) {
					const template = document.createElement("template");
					template.innerHTML = renderMediaEntry(item);
					stampAstroCid(template.content, cidAttrName);
					timeline.appendChild(template.content);
				}

				nextOffset =
					payload?.nextOffset === null || payload?.nextOffset === undefined
						? ""
						: String(payload.nextOffset);
				sentinel.dataset.nextOffset = nextOffset;

				if (!nextOffset) {
					observer.disconnect();
					sentinel.remove();
				}
			} finally {
				loading = false;
			}
		};

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					void loadMore();
				}
			},
			{ rootMargin: "320px 0px" },
		);

		if (nextOffset) {
			observer.observe(sentinel);
		} else {
			sentinel.remove();
		}
	}
</script>

<style>
	.media-timeline {
		--timeline-date-column: 4.5rem;
		--timeline-rail-column: 1.4rem;
		--timeline-gap: 1rem;
		position: relative;
	}

	.media-timeline::before {
		content: "";
		position: absolute;
		top: 0.78rem;
		bottom: 0.4rem;
		left: calc(var(--timeline-date-column) + var(--timeline-gap) + (var(--timeline-rail-column) / 2));
		width: 1px;
		background: color-mix(in srgb, var(--accent) 42%, white 58%);
		border-radius: 999px;
		opacity: 0.55;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.media-timeline__entry {
		display: grid;
		grid-template-columns: var(--timeline-date-column) var(--timeline-rail-column) minmax(0, 1fr);
		gap: var(--timeline-gap);
		align-items: start;
	}

	.media-timeline__entry + .media-timeline__entry {
		margin-top: 2.9rem;
	}

	.media-timeline__date {
		position: sticky;
		top: 5.35rem;
		display: inline-block;
		padding-top: 0.15rem;
		font-size: 0.82rem;
		line-height: 1.25;
		color: var(--muted);
	}

	.media-timeline__rail {
		position: relative;
		min-height: 100%;
	}

	.media-timeline__dot {
		position: absolute;
		top: 0.42rem;
		left: 50%;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 999px;
		background: var(--surface);
		border: 3px solid color-mix(in srgb, var(--accent) 82%, white 18%);
		transform: translateX(-50%);
	}

	.media-timeline__content {
		min-width: 0;
	}

	.media-timeline__kicker {
		margin: 0 0 0.55rem;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.media-timeline__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 0.75rem;
	}

	.media-timeline__title {
		margin: 0;
		font-family: "Fira Sans", sans-serif;
		font-size: clamp(1.28rem, 2.35vw, 1.72rem);
		line-height: 1.14;
		letter-spacing: -0.02em;
	}

	.media-timeline__title a {
		color: inherit;
		text-decoration: none;
	}

	.media-timeline__lede,
	.media-timeline__meta {
		margin: 0.85rem 0 0;
	}

	.media-timeline__lede {
		font-size: 1rem;
		line-height: 1.68;
		color: var(--muted);
	}

	.media-timeline__meta {
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--muted);
	}

	.media-timeline__meta--artist {
		margin-top: 0.35rem;
	}

	.media-timeline__meta--status {
		margin-top: 0.35rem;
		font-size: 0.88rem;
		color: color-mix(in srgb, var(--accent) 70%, var(--muted) 30%);
	}

	.media-timeline__lede--compact {
		margin-top: 0.55rem;
	}

	.media-timeline__lede--mini {
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.media-entry {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-top: 1rem;
		align-items: start;
	}

	.media-entry--track {
		grid-template-columns: minmax(4.9rem, 5.5rem) minmax(0, 1fr);
		gap: 0.95rem;
		padding: 0.95rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--surface) 26%, transparent);
		box-shadow: none;
	}

	.media-entry__mini-player {
		display: grid;
		gap: 0.65rem;
		min-width: 0;
	}

	.media-entry__body {
		min-width: 0;
	}

	.media-entry__heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.8rem;
	}

	.media-timeline__title--media {
		font-size: clamp(1.18rem, 2.1vw, 1.55rem);
	}

	.media-timeline__title--mini {
		font-size: clamp(1rem, 1.65vw, 1.18rem);
		line-height: 1.2;
	}

	.media-entry__cover {
		display: block;
		width: 100%;
		text-decoration: none;
		color: inherit;
	}

	.media-entry__cover--mini {
		width: 100%;
		align-self: start;
	}

	.media-entry__art {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: 0.85rem;
	}

	.media-entry__art--mini {
		aspect-ratio: 1 / 1;
		border-radius: 0.95rem;
		box-shadow: 0 0.7rem 1.5rem rgba(0, 0, 0, 0.16);
	}

	.media-entry__art--poster {
		aspect-ratio: 2 / 3;
	}

	.media-entry__art--natural {
		aspect-ratio: auto;
		height: auto;
		object-fit: contain;
	}

	.media-entry__fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--surface) 82%, white 18%);
		color: var(--muted);
		font-size: 0.82rem;
