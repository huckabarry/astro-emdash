---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { getImageUrl, formatDisplayDate } from "../lib/afterword";
import {
	PUBLIC_ARCHIVE_CACHE_CONTROL,
	getPostStringField,
	getResolvedPostTagSlugMap,
} from "../lib/emdash-content";

Astro.response.headers.set("Cache-Control", PUBLIC_ARCHIVE_CACHE_CONTROL);

const { entries, cacheHint } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: 120,
});

Astro.cache.set(cacheHint);

const tagSlugMap = await getResolvedPostTagSlugMap(entries);
const posts = entries
	.filter((post) => (tagSlugMap.get(post.id) || []).includes("field-notes"))
	.filter((post) => getPostStringField(post, "source_type") !== "earlier-web")
	.slice(0, 24);
---

<Base title="Field Notes" description="Personal, place-based writing and quieter observations.">
	<section class="stream-head">
		<h1 class="stream-head__title">Field Notes</h1>
		<p class="stream-head__lede">Personal, place-based writing and quieter observations.</p>
	</section>

	<section class="blog-list blog-list--archive" aria-label="Field notes">
		{posts.map((post) => {
			const coverImage = getImageUrl(post.data.featured_image, Astro.url.origin);
			return (
				<article class:list={["blog-row", coverImage && "blog-row--with-image"]}>
					<a class="blog-row__link" href={`/posts/${post.id}`}>
						{coverImage && <img class="blog-row__image" src={coverImage} alt={post.data.title} loading="lazy" />}
						<div class="blog-row__body">
							<time class="blog-row__date" datetime={post.data.publishedAt?.toISOString()}>
								{formatDisplayDate(post.data.publishedAt ?? undefined)}
							</time>
							<h2>{post.data.title}</h2>
							<p>{post.data.excerpt}</p>
							<span class="blog-row__read-more">Read more <span aria-hidden="true">→</span></span>
						</div>
					</a>
				</article>
			);
		})}
	</section>
</Base>
