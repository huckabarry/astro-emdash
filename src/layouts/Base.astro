---
import { getMenu, getSection, getSiteSetting, getWidgetArea } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import WidgetRenderer from "../components/WidgetRenderer.astro";
import { localizePath, navLabel, normalizeLocale } from "../lib/locale";
import "../styles/theme.css";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	sidebar?: boolean;
}

const {
	title,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	sidebar,
} = Astro.props;

const configuredSiteTitle = await getSiteSetting("title");
const siteTitle = typeof configuredSiteTitle === "string" && configuredSiteTitle.trim()
	? configuredSiteTitle.trim()
	: "Afterword";
type NavLink = {
	href: string;
	label: string;
	target?: string | null;
};
const pageRouteAliases = new Map([
	["about", "/about"],
	["hello", "/hello"],
	["colophon", "/colophon"],
]);
const profile = {
	displayName: "Bryan Robb",
	avatarUrl: "/assets/images/status-avatar.jpg",
};
const fullTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const fallbackPrimaryNavLinks: Array<{ href: string; labelKey: string; target?: string | null }> = [
	{ href: "/", labelKey: "home" },
	{ href: "/status", labelKey: "status" },
	{ href: "/gallery", labelKey: "gallery" },
	{ href: "/about", labelKey: "about" },
];
const footerNavLinks = [
	{ href: "/hello", labelKey: "hello" },
	{ href: "/colophon", labelKey: "colophon" },
	{ href: "/subscribe", labelKey: "subscribe" },
	{ href: "/check-ins/atlas", labelKey: "atlas" },
];
const footerWidgetArea = await getWidgetArea("footer");
const hasSidebar = typeof sidebar === "boolean" ? sidebar : Astro.slots.has("sidebar");
const subtitleSection = await getSection("subtitle");
const primaryMenu = await getMenu("primary");
const footerMenu = await getMenu("footer");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

function isActive(url: string) {
	const localizedUrl = localizePath(url, currentLocale);
	if (url === "/") {
		return Astro.url.pathname === localizedUrl;
	}

	return Astro.url.pathname === localizedUrl || Astro.url.pathname.startsWith(`${localizedUrl}/`);
}

function normalizeMenuHref(url: string) {
	if (!url.startsWith("/")) return url;

	const match = url.match(/^\/(?:(it)\/)?pages\/([^/?#]+)$/);
	if (!match) return url;

	const [, locale, slug] = match;
	const canonical = pageRouteAliases.get(slug);
	if (!canonical) return url;
	return locale ? `/it${canonical}` : canonical;
}

function footerLabel(labelKey: string) {
	if (labelKey === "atlas") return "Atlas";
	return navLabel(labelKey, currentLocale);
}

function portableTextPlainText(value: unknown) {
	// EmDash sections are stored as PortableText-ish blocks. We only need a short
	// inline subtitle; grab text nodes from the first block.
	if (!Array.isArray(value)) return null;
	const first = value[0];
	if (!first || typeof first !== "object") return null;
	const children = (first as { children?: unknown }).children;
	if (!Array.isArray(children)) return null;
	const text = children
		.map((child) => {
			if (!child || typeof child !== "object") return "";
			const t = (child as { text?: unknown }).text;
			return typeof t === "string" ? t : "";
		})
		.join("")
		.trim();
	return text || null;
}

const subtitleText = portableTextPlainText(subtitleSection?.content) ?? null;
const currentLocale = normalizeLocale(Astro.currentLocale);
const prefetchMode = "hover";
const primaryNavLinks: NavLink[] = primaryMenu?.items?.length
	? primaryMenu.items.map((item) => ({
			href: normalizeMenuHref(item.url),
			label: item.label,
			target: item.target,
	  }))
	: fallbackPrimaryNavLinks.map((item) => ({
			href: item.href,
			label: navLabel(item.labelKey, currentLocale),
			target: item.target ?? null,
	  }));
const localizedFooterNavLinks: NavLink[] = footerMenu?.items?.length
	? footerMenu.items.map((item) => ({
			href: normalizeMenuHref(item.url),
			label: item.label,
			target: item.target,
	  }))
	: footerNavLinks.map((item) => ({
			href: localizePath(item.href, currentLocale),
			label: footerLabel(item.labelKey),
			target: null,
	  }));
const languageLinks = [
	{
		href: currentLocale === "it" ? Astro.url.pathname.replace(/^\/it(?=\/|$)/, "") || "/" : `/it${Astro.url.pathname === "/" ? "" : Astro.url.pathname}`,
		label:
			currentLocale === "it"
				? navLabel("languageEnglish", currentLocale)
				: navLabel("languageItalian", currentLocale),
	},
];
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2" />
		<title>{fullTitle}</title>
		<link rel="icon" href={profile.avatarUrl} />
		<link rel="apple-touch-icon" href={profile.avatarUrl} />
		<Font cssVariable="--font-sans" />
		<Font cssVariable="--font-mono" />
		<ClientRouter fallback="swap" />
		<script
			is:inline
			defer
			src="https://analytics.afterword.blog/script.js"
			data-website-id="28725456-c68f-411a-a1d6-0b548e1c5213"
		></script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a id="skip-to-content" href="#main-content" class="skip-link">Skip to content</a>

		<div class:list={["site-shell", hasSidebar && "site-shell--with-sidebar"]}>
			<header class="site-header h-card">
				<a class="site-header-avatar-link u-url u-uid exclude" href={localizePath("/", currentLocale)} data-astro-prefetch={prefetchMode}>
					<img class="avatar u-photo" src={profile.avatarUrl} alt={profile.displayName} />
				</a>

				<div class="site-header-copy">
					<div class="site-title-row">
						<div class="site-title p-name">
							<a class="u-url exclude" href={localizePath("/", currentLocale)} data-astro-prefetch={prefetchMode}>
								<span class="site-title__name">{siteTitle}</span>
							</a>
						</div>
					</div>
					{subtitleText ? <div class="site-title-subline">{subtitleText}</div> : null}
					<div class="site-nav-row">
						<nav class="site-nav" aria-label="Primary">
							<ul class="site-nav-list">
								{primaryNavLinks.map((link) => (
									<li class="site-nav-list-item">
										<a
											class="site-nav-item"
											href={localizePath(link.href, currentLocale)}
											aria-current={isActive(link.href) ? "page" : undefined}
											data-astro-prefetch={prefetchMode}
											target={link.target || undefined}
											rel={link.target === "_blank" ? "noreferrer" : undefined}
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					</div>
				</div>
			</header>

			{Astro.url.pathname !== "/" && <hr class="site-rule" />}

			<div class:list={["site-content-shell", hasSidebar && "site-content-shell--with-sidebar"]}>
				<main id="main-content" class="site-main">
					<slot />
				</main>

				{hasSidebar ? (
					<aside class="site-sidebar" aria-label="Sidebar">
						<slot name="sidebar" />
					</aside>
				) : null}
			</div>

			<hr class="site-rule" />

			<footer class="site-foot">
				{footerWidgetArea?.widgets.length ? (
					<div class="site-foot-widgets" aria-label={footerWidgetArea.label}>
						{footerWidgetArea.widgets.map((widget) => (
							<WidgetRenderer widget={widget} />
						))}
					</div>
				) : null}

					<div class="site-foot-nav">
					{localizedFooterNavLinks.map((link, index) => (
						<>
							<a
								class="site-foot-nav-item"
								href={link.href}
								target={link.target || undefined}
								rel={link.target === "_blank" ? "noreferrer" : undefined}
							>
								{link.label}
							</a>
							{index < localizedFooterNavLinks.length - 1 && <span class="site-foot-separator">/</span>}
						</>
					))}
					{languageLinks.map((link) => (
						<>
							<span class="site-foot-separator">/</span>
							<a class="site-foot-nav-item" href={link.href}>{link.label}</a>
						</>
					))}
				</div>
			</footer>
		</div>

		{Astro.url.pathname === "/" ? (
			<script is:inline>
				(() => {
					try {
						if (sessionStorage.getItem("aw_prefetch_gallery") === "1") return;

						const conn = navigator.connection;
						if (conn && (conn.saveData || String(conn.effectiveType || "").includes("2g"))) return;

						sessionStorage.setItem("aw_prefetch_gallery", "1");

						const warm = () => {
							const controller = new AbortController();
							const timeoutId = setTimeout(() => controller.abort(), 5000);
							fetch("/gallery", {
								signal: controller.signal,
								credentials: "omit",
								headers: { "X-Afterword-Prefetch": "gallery" },
							})
								.catch(() => {})
								.finally(() => clearTimeout(timeoutId));
						};

						setTimeout(() => {
							if ("requestIdleCallback" in window) {
								window.requestIdleCallback(warm, { timeout: 2000 });
							} else {
								warm();
							}
						}, 3000);
					} catch {
						// no-op
					}
				})();
			</script>
		) : null}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
