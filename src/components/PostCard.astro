---
interface Props {
	title: string;
	excerpt?: string;
	href: string;
	date?: Date;
	showYear?: boolean;
}

const { title, excerpt, href, date, showYear = false } = Astro.props;
const dateLabel = date
	? date.toLocaleDateString("en-US", {
			month: "short",
			day: "numeric",
			year: "numeric",
		})
	: "";
---

<article class="blog-row">
	<a href={href} class="blog-row__link exclude">
		<div class="blog-row__body">
			{dateLabel && <time class="blog-row__date">{dateLabel}</time>}
			<h3>{title}</h3>
			{excerpt && <p>{excerpt}</p>}
			{showYear && <span class="blog-row__read-more">Read more <span aria-hidden="true">→</span></span>}
		</div>
	</a>
</article>
