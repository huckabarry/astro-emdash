---
interface Props {
	placeholder?: string;
}

const {
	placeholder = "Search...",
} = Astro.props;
---

<form action="/search" method="get" class="widget-search">
	<input
		class="widget-search__field"
		type="search"
		name="q"
		placeholder={placeholder}
		aria-label="Search"
	/>
	<button class="widget-search__button" type="submit">Search</button>
</form>
